                    <!-- PARAMETER DEFINITION: RteVfbTraceAnonymousClientEnabled -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0167fe91-8f4b-4149-9298-1c52d23fc76a">
                      <SHORT-NAME>RteVfbTraceAnonymousClientEnabled</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The RTE generator shall globally enable VFB trace functions without client prefix when RteVfbTraceAnonymousClientEnabled is set to "true".</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Rte_09163</RELATED-TRACE-ITEM-REF>
