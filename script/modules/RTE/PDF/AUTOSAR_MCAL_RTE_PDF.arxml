                <!-- Container Definition: RteExclusiveAccessOptimization -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8ec1f528-1bc0-409d-87b2-cda8a82f784b">
                  <SHORT-NAME>RteExclusiveAccessOptimization</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Configuration of the optimized access behavior to be generated. In other words, access shall be mutually exclusive. How this is realized e.g. non preemptive task mapping, exclusive areas, mode management, exclusive access during ECU startup and shutdown or scheduling in exclusive time slots is up to the ECU integrator.</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Rte_09165</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
