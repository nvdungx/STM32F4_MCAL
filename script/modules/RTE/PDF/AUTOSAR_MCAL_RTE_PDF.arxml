                <!-- Container Definition: RteComUser -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:14fd203b-cf9b-4554-98df-3b8b1d2db061">
                  <SHORT-NAME>RteComUser</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Defines a ComUser instance in the Rte.</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
                  <INTRODUCTION>
                    <P>
                      <L-1 L="EN">One ComUser instance can either server for ComSignals and ComSignalGroups on multiple EcucPartitons or exactly one EcucPartiton. How many ComUser instances an Rte requires is vendor specific.</L-1>
                    </P>
                  </INTRODUCTION>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Rte_09213</RELATED-TRACE-ITEM-REF>
