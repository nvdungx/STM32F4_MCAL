                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:957b3bee-08c9-8481-1f22-02bb509bddac">
                          <SHORT-NAME>RTE_RIPS_ON</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                  <REFERENCES>
                    <!-- Reference Definition: RteRipsPluginConfigurationRef -->
                    <ECUC-URI-REFERENCE-DEF UUID="ECUC:42edaae2-2594-462d-ac93-6690820ba5ea">
                      <SHORT-NAME>RteRipsPluginConfigurationRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to the configuration container of the RTE Implementation Plug-in holding the RTE relevant settings.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">All referenced RTE Implementation Plug-ins are considered for the RTE generation.</L-1>
                        </P>
                      </INTRODUCTION>
