                          <SHORT-NAME>LdComUserIPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Contains the configuration parameters for the LdCom's signal (LdComIPdu) inside a LdCom user module.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LdCom_00028</RELATED-TRACE-ITEM-REF>
