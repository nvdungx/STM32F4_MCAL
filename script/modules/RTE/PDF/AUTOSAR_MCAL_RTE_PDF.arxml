                        <!-- Reference Definition: RteBswEventSuccessorSyncPointRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:71abe22f-c77b-4594-8472-2d6e6b7217b6">
                          <SHORT-NAME>RteBswEventSuccessorSyncPointRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The RteBswEventSuccessorSyncPointRef is necessary to provide a cross core synchronization in case of BswEvents triggered by the same event source but mapped to tasks belonging to different partitions on different cores.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">The synchronization point must be reached by all referencing BswEvents before the execution in all related tasks is continued. In case of RteBswEventSuccessorSyncPointRef the BswModuleEntity activated by the mapped BswEvent is executed before the synchronization point is entered.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Rte_09131</RELATED-TRACE-ITEM-REF>
