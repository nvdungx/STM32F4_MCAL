                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>4</DEFAULT-VALUE>
                              <MAX>4</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmRequestFileTransferMaxFileAndDirName -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:28af9db8-c24f-4a0f-8383-cb961cf52e9b">
                              <SHORT-NAME>DcmRequestFileTransferMaxFileAndDirName</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Defines the maximum size allowed for the FileAndDirName parameter with RTE interfaces used for RequestFileTransfer.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01130</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
