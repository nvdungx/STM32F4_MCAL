                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ebbc41d8-2f18-4e02-9856-10cf15659bf5">
                              <SHORT-NAME>DcmDspAuthenticationRow</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container contains the definition of a single role. Each role is a bit in the authentication role bitfield.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01211</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>31</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: DcmDspAuthenticationRoleBitPosition -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:eff374bb-76d4-4393-9a8b-fd87544ee8c7">
                                  <SHORT-NAME>DcmDspAuthenticationRoleBitPosition</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the bit number that represents the role in the authentication bit field. The bit mask is aligned with the logical bit calculations: 2^DcmDspAuthenticationRoleBitPosition.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01212</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>31</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
