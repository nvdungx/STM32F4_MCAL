                              <MAX>4294967295</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoeSchedulerRate -->
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0c997ab0-cfa5-422c-a5fc-adc93453ca55">
                              <SHORT-NAME>DcmDspRoeSchedulerRate</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Calling rate of the RoE scheduler.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">The parameter value is defined in seconds and shall be a multiple of DcmTaskTime.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01235</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                            </ECUC-FLOAT-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoeStoreEventSupport -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8bac7310-9897-46c2-8a14-3e4c2ad25c62">
                              <SHORT-NAME>DcmDspRoeStoreEventSupport</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Configures if ResponseOnEvent storageState is supported. If set to true, the use of the storageState bit is supported and if set to false the use of the storageState bit is not supported.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01234</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>true</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: DcmDspRoutine -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:28d866b1-d42d-44f8-a3be-e05510d9cef4">
                          <SHORT-NAME>DcmDspRoutine</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the configuration (parameters) for Routines</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00640</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: DcmDspRoutineFncSignature -->
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:5a30dde4-4037-44e9-b581-0cf9749ad341">
                              <SHORT-NAME>DcmDspRoutineFncSignature</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">If the parameter is set to ROUTINE_FNC_NORMAL the routine control functions DcmDspStartRoutineFnc, DcmDspStopRoutineFnc or DcmDspRequestResultsRoutineFnc are defined with the signature for a cluster local user with separate arguments per signal.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">If the parameter is set to ROUTINE_FNC_PROXY the routine control functions DcmDspStartRoutineFnc, DcmDspStopRoutineFnc or DcmDspRequestResultsRoutineFnc with a fixed number of arguments passing a common buffer for all signals and a DataLength.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01215</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>ROUTINE_FNC_NORMAL</DEFAULT-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3a6c323e-b03e-94d5-5ca7-ab0876c5589e">
                                  <SHORT-NAME>ROUTINE_FNC_NORMAL</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:293dde95-f15b-9299-45e6-77e6fc7d8feb">
                                  <SHORT-NAME>ROUTINE_FNC_PROXY</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoutineIdentifier -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9bb602ee-9693-42a8-970d-f386134562c1">
                              <SHORT-NAME>DcmDspRoutineIdentifier</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">2 bytes Identifier of the RID</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Within each DcmConfigSet all DcmDspRoutineIdentifier values shall be unique.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00641</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>65535</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoutineInfoByte -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0ee236bf-e27c-4fd1-aa6e-7fd408d6a978">
                              <SHORT-NAME>DcmDspRoutineInfoByte</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Manufacturer specific value reported to the tester for the record identifiers 0xE000 to OxE1FF. (OBD use cases)</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01063</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoutineUsed -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d1c3a0c1-f010-44f4-920d-9a3aa8528dd0">
                              <SHORT-NAME>DcmDspRoutineUsed</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Allow to activate or deactivate the usage of a Routine, for multi purpose ECUs</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">True = Routine is available False = Routine is not available</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00807</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoutineUsePort -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:00ea77d8-037e-4045-91a8-013b03aac509">
                              <SHORT-NAME>DcmDspRoutineUsePort</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">If this parameter is set to true, the DCM uses a port requiring a PortInterface RoutineServices_{RoutineName}.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">The R-Port is named RoutineServices_{RoutineName} where {RoutineName} is the name of the container DcmDspRoutine In that case, the configuration must not provide function names in DcmDspStartRoutineFnc, DcmDspStopRoutineFnc or DcmDspRequestResultsRoutineFnc. If this is false, the DCM expects to find the names of the functions to be used in DcmDspStartRoutineFnc, DcmDspStopRoutineFnc or DcmDspRequestResultsRoutineFnc.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00724</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <!-- Container Definition: DcmDspRequestRoutineResults -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c78bfa15-ba6e-46fa-8c32-4b00bb1ab70f">
                              <SHORT-NAME>DcmDspRequestRoutineResults</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Provides the configuration of RequestResult subservice for RoutineControl service.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Existence indicates that the RequestRoutineResults in the RoutineControl is supported.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01023</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: DcmDspRequestRoutineResultsConfirmationEnabled -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a313c3ac-3d4b-4d2a-973c-7f258f12b05e">
                                  <SHORT-NAME>DcmDspRequestRoutineResultsConfirmationEnabled</SHORT-NAME>
