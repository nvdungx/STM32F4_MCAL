                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7ca165d2-6df2-9715-3b2e-f268b689a8d0">
                              <SHORT-NAME>DcmDspAddressAndLengthFormatIdentifier</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container contains the configuration of the supported AddressAndLengthFormatIdentifiers for memory access.</L-2>
                              </DESC>
