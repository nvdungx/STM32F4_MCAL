                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: DcmDspRoeMaxNumOfStoredDTCStatusChangedEvents -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:be1ed253-c35f-4ffb-a56e-50a7a1feb90c">
                              <SHORT-NAME>DcmDspRoeMaxNumOfStoredDTCStatusChangedEvents</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Maximum number of changed DTC events that can be stored within one DcmDspRoeSchedulerRate interval.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01239</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
