                                                <!-- Container Definition: DcmDspAlternativeDiagnosticDataElement -->
                                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:256fdad2-bb31-153e-9b66-aca7f5f05463">
