                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:933e79e0-afb0-4e61-b24d-4186366ff81e">
                                  <SHORT-NAME>DcmDsdSubService</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container contains the configuration (DSD parameters) for a subservice of a service. Only those services may have subservices, which have the DcmDsdSidTabSubfuncAvail configured as TRUE.</L-2>
                                  </DESC>
