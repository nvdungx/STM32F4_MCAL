                            <!-- PARAMETER DEFINITION: DcmDspRoeMaxSupportedDIDLength -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:57a43187-dacf-406e-8155-0bb8067fa4f1">
                              <SHORT-NAME>DcmDspRoeMaxSupportedDIDLength</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Maximum DID response size in bytes allowed for a DID that is used for onComparisonOfValues or onChangeOfDataIdentifier.</L-2>
                              </DESC>
