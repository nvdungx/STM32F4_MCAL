                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:ee92360f-60c0-42b1-b31b-4ff5dfc700c0">
                              <SHORT-NAME>DcmSwcSRDataElementRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to environmental conditions.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">It is possible to reference a S/R Receiver-Port to read physical values and compare (equal, greater, less,...) them with a configured value that is defined by DcmSwcDataElementValue.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01037</RELATED-TRACE-ITEM-REF>
