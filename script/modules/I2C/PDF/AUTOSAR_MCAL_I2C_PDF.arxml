                          <MAX>18446744073709551615</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: I2cHwUnitBaseAddress -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e3d8258e-bd97-44b0-9847-2c25d259e0dd">
                          <SHORT-NAME>I2cHwUnitBaseAddress</SHORT-NAME>
