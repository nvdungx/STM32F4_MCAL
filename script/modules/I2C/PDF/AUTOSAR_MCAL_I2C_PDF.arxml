                        <!-- PARAMETER DEFINITION: I2cDeviceAddress -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e59532a1-e22d-4c8f-a05d-f98a3b8260cd">
                          <SHORT-NAME>I2cDeviceAddress</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The address of a Target device which is accessed by the Controller.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Values bigger than [ARTechTerm{0x7F (127)}] lead to Extended Addressing.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_I2c_00018</RELATED-TRACE-ITEM-REF>
