                      <SHORT-NAME>I2cDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter switches the Development Error Detection and Notification ON or OFF.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* True: Development error detection is enabled. * False: Development error detection is disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_I2c_00004</RELATED-TRACE-ITEM-REF>
