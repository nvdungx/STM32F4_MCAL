                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>18446744073709551615</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: I2cHwUnitMode -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:3fd81bb8-b902-4953-9c0f-3b83d937c4c9">
                          <SHORT-NAME>I2cHwUnitMode</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Select whether the HW unit will be used in Controller or Target mode.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
