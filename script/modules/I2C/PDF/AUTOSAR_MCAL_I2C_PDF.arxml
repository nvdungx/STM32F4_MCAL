                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: I2cBaudRate -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8da9c72e-0644-408e-819d-557bd77da8f5">
                          <SHORT-NAME>I2cBaudRate</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The baud rate of the bus in kbit/s.</L-2>
