                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2059adad-b494-948f-319e-d6cb05e5975d">
                                      <SHORT-NAME>V2XDM_CONN_SRC_OP_EXISTS</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:472cfa35-054f-9589-4746-717309542dd6">
                                      <SHORT-NAME>V2XDM_CONN_SRC_OP_LENGTH</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <!-- Reference Definition: V2xDMConnectionSourceTargetRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:db4a4ec7-1902-47f9-b163-61b9fcae95f2">
                                  <SHORT-NAME>V2xDMConnectionSourceTargetRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Links to the simple type of a V2x message.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00073</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-CHOICE-CONTAINER-DEF">/AUTOSAR/EcucDefs/V2xDM/V2xDMConfigSet/V2xDMStack/V2xDMMessage/V2xDMSimpleType</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                              <SUB-CONTAINERS>
                                <!-- Container Definition: V2xDMConnectionSourceContext -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1106a811-c78f-4ac7-918a-77b37f2cf196">
                                  <SHORT-NAME>V2xDMConnectionSourceContext</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Contains information to uniquely address a V2X message element. I.e. the V2x message element can be contained in a SequenceOf. In that case the index inside the SequenceOf must be provided to avoid an ambiguous reference.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00069</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: V2xDMConnectionSourceContextIndex -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:de35ce1b-87cf-48f2-a9d5-be4d92372b7d">
                                      <SHORT-NAME>V2xDMConnectionSourceContextIndex</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Index to the SequenceOf element that the SourceContextRef references to.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00070</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <MAX>65535</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                  </PARAMETERS>
                                  <REFERENCES>
                                    <!-- Reference Definition: V2xDMConnectionSourceContextRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:13bffeef-d58c-44a6-8d96-1639abc8edc3">
                                      <SHORT-NAME>V2xDMConnectionSourceContextRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Reference to the SequenceOf element of a V2x message.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00071</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/V2xDM/V2xDMConfigSet/V2xDMStack/V2xDMMessage/V2xDMStructuredType/V2xDMStructuredTypeSequenceOf</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: V2xDMConversion -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3e471925-c408-45c7-9b17-75c41423e0be">
                              <SHORT-NAME>V2xDMConversion</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Allows to define a conversion routine to adapt V2x simple item(s) to the data catalog element.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00068</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: V2xDMConversionFunc -->
                                <ECUC-FUNCTION-NAME-DEF UUID="ECUC:eb856e11-165b-4476-8353-3f3f7f98800a">
                                  <SHORT-NAME>V2xDMConversionFunc</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter provides the function name for the callback &lt;V2xDM_ItemConversionFunc&gt;.It is used to convert the simple type information into the data catalog item value and its base type.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00075</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    <ECUC-FUNCTION-NAME-DEF-CONDITIONAL></ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                                  </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                </ECUC-FUNCTION-NAME-DEF>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <!-- Container Definition: V2xDMConversionFunction -->
                                <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:0bf22e27-57a3-49c1-8f8b-bd0dc9e43586">
                                  <SHORT-NAME>V2xDMConversionFunction</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the conversion function container that shall be applied to convert the V2x message element into the unified data catalog item.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00074</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <CHOICES>
                                    <!-- Container Definition: V2xDMConversionFunctionLinear -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5ecb4297-3d11-466a-aaf3-8e29a5a8436f">
                                      <SHORT-NAME>V2xDMConversionFunctionLinear</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">This container defines th parameter for the linear conversion routine.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00076</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <MULTIPLICITY-CONFIG-CLASSES>
                                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      </MULTIPLICITY-CONFIG-CLASSES>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                      <PARAMETERS>
                                        <!-- PARAMETER DEFINITION: V2xDMConversionFunctionLinearConstant -->
                                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:81ade697-931e-4b26-a302-ef85fc611617">
                                          <SHORT-NAME>V2xDMConversionFunctionLinearConstant</SHORT-NAME>
                                          <DESC>
                                            <L-2 L="EN">This parameter defines the offset to the linear conversion function</L-2>
                                          </DESC>
                                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00077</RELATED-TRACE-ITEM-REF>
                                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                          <SCOPE>LOCAL</SCOPE>
                                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                          <VALUE-CONFIG-CLASSES>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                          </VALUE-CONFIG-CLASSES>
                                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                        </ECUC-FLOAT-PARAM-DEF>
                                        <!-- PARAMETER DEFINITION: V2xDMConversionFunctionLinearFactor -->
                                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4a7c32ce-cf12-4433-99dd-b868fde7869d">
                                          <SHORT-NAME>V2xDMConversionFunctionLinearFactor</SHORT-NAME>
                                          <DESC>
                                            <L-2 L="EN">This defines the scale factor for the linear conversion function.</L-2>
                                          </DESC>
                                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00078</RELATED-TRACE-ITEM-REF>
                                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                          <SCOPE>LOCAL</SCOPE>
                                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                          <VALUE-CONFIG-CLASSES>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                          </VALUE-CONFIG-CLASSES>
                                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                        </ECUC-FLOAT-PARAM-DEF>
                                      </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                  </CHOICES>
                                </ECUC-CHOICE-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: V2xDMLink -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1e6b0afc-5a9b-4db5-9343-4e3e927f8149">
                      <SHORT-NAME>V2xDMLink</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the links between the VariableDataPrototypes of the V2x object to the V2x catalog items.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00079</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <REFERENCES>
                        <!-- Reference Definition: V2xDMLinkCatalogItemRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:a0ba1e6f-db16-4e59-9f1c-a3daf72aefd8">
                          <SHORT-NAME>V2xDMLinkCatalogItemRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">References to the catalog item that is used for this link.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00080</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/V2xDM/V2xDMConfigSet/V2xDMCatalogItem</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <!-- Instance Reference Definition: V2xDMLinkV2xObjectElementInstanceRef -->
                        <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:64702ebf-7597-433a-9b48-b0f4d8896c3c">
                          <SHORT-NAME>V2xDMLinkV2xObjectElementInstanceRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container references to the port prototype and VariableDataPrototype as a V2x object.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00081</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-CONTEXT>ROOT-SW-COMPOSITION-PROTOTYPE SW-COMPONENT-PROTOTYPE PORT-PROTOTYPE AUTOSAR-DATA-PROTOTYPE IMPLEMENTATION-DATA-TYPE-ELEMENT*</DESTINATION-CONTEXT>
                          <DESTINATION-TYPE>IMPLEMENTATION-DATA-TYPE-ELEMENT</DESTINATION-TYPE>
                        </ECUC-INSTANCE-REFERENCE-DEF>
                      </REFERENCES>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: V2xDMMsgQueue -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:bec52cda-030d-4267-b3a8-dfc099088d1a">
                      <SHORT-NAME>V2xDMMsgQueue</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies a message queue for incoming V2x messages of the data manager. If this container is not present, no queue is used for incoming V2x messages. If it is present, the elements of the container specifies the queue depth and its elements.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00102</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: V2xDMMsgQueueElementSize -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ac06fee6-b54a-4c0b-8178-1fb2ca526620">
                          <SHORT-NAME>V2xDMMsgQueueElementSize</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Size of a queue entry in bytes. All queue entries have the same size. The value shall be large enough to store the largest V2x message.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00097</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: V2xDMMsgQueueNumberOfEntries -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a34e9635-a4e0-41b0-afbb-b00c5784cefd">
                          <SHORT-NAME>V2xDMMsgQueueNumberOfEntries</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the number of Queue entries for incoming V2x messages. One entry per V2x message.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">A number of 0 in this field disables the queue and actions are performed only in the V2xDM_RxIndication.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00096</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: V2xDMStack -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9b4a229a-d61b-4ff8-9058-f9bfabb26f66">
                      <SHORT-NAME>V2xDMStack</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Holds the V2x stack specific container and parameter.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00005</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <SUB-CONTAINERS>
                        <!-- Container Definition: V2xDMMessage -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:103df866-dd2e-48b8-a4e1-522efadeb12b">
                          <SHORT-NAME>V2xDMMessage</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Definition of a V2x message and its layout</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00006</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: V2xDMMsgId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:02f01bf4-b432-466f-b1ee-f866c23aeadf">
                              <SHORT-NAME>V2xDMMsgId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Identifier of the message. The set of V2x message identifiers shall be consecutive and gapless.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00088</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                              <MAX>4294967295</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- Choice Reference Definition: V2xDMMsgRootRef -->
                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:5167893a-4492-4716-8256-1f0845709c18">
                              <SHORT-NAME>V2xDMMsgRootRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This element links to the first structured element within the V2x message.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00012</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DESTINATION-REFS>
                                <DESTINATION-REF DEST="ECUC-CHOICE-CONTAINER-DEF">/AUTOSAR/EcucDefs/V2xDM/V2xDMConfigSet/V2xDMStack/V2xDMMessage/V2xDMSimpleType</DESTINATION-REF>
                                <DESTINATION-REF DEST="ECUC-CHOICE-CONTAINER-DEF">/AUTOSAR/EcucDefs/V2xDM/V2xDMConfigSet/V2xDMStack/V2xDMMessage/V2xDMStructuredType</DESTINATION-REF>
                              </DESTINATION-REFS>
                            </ECUC-CHOICE-REFERENCE-DEF>
                          </REFERENCES>
                          <SUB-CONTAINERS>
                            <!-- Container Definition: V2xDMPdu -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f37e9d3e-d46d-4853-8270-9aecd820aa10">
                              <SHORT-NAME>V2xDMPdu</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Container for parameters that are necessary for the configuration of the V2xDM to serve as the UpperLayer of the PDU-Router module.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00087</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: V2xDMPduDirection -->
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:429374bb-425e-4d78-b1cf-5f648acb957d">
                                  <SHORT-NAME>V2xDMPduDirection</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the direction of the PDU:</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">V2XDM_PDU_SEND - V2xDM passes on the V2x message as raw data to the PduR. V2XDM_PDU_RECEIVE - V2xDM receives the V2x message through the PduR (no V2x stack present in the ECU).</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00091</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:eafc3e7d-0891-8d53-3a93-8f85db19c3ef">
                                      <SHORT-NAME>V2XDM_PDU_RECEIVE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2aa69463-6e7d-8c29-3d72-a992eb54e98a">
                                      <SHORT-NAME>V2XDM_PDU_SEND</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: V2xDMPduId -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6a40521d-6f64-4365-be57-bb311d1d56c3">
                                  <SHORT-NAME>V2xDMPduId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">The numerical value used as the ID of this I-PDU. The ComIPduHandleId</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">is required by the API calls PduR_V2xDMRxIndication to receive I-PDUs from the PduR (ComIP-duDirection: Receive) For Tx-I-PDUs (ComIPduDirection: Send), this handle Id is used for the APIs call PduR_V2xDMTransmit to transmit I-PDUs.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00089</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <!-- Reference Definition: V2xDMPduRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:06296147-6d06-48e2-8bbd-cda6824dde42">
                                  <SHORT-NAME>V2xDMPduRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the global Pdu structure.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00090</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: V2xDMSimpleType -->
                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:da08264e-e2b8-44eb-8d89-736b578aeb8a">
                              <SHORT-NAME>V2xDMSimpleType</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Definition of simple types within a V2x message as a choice of simple types.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00008</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <CHOICES>
                                <!-- Container Definition: V2xDMSimpleTypeBitString -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d1cf008c-0b58-4d89-b39c-dd32b483ed8d">
                                  <SHORT-NAME>V2xDMSimpleTypeBitString</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Definition of the ASN.1 Bit String</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00013</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <PARAMETERS>
