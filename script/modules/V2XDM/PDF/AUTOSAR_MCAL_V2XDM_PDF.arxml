            <!-- Module Definition: V2xDM -->
            <ECUC-MODULE-DEF UUID="ECUC:511c05e5-2e36-4ef0-8e67-7ffd9c6ce375">
              <SHORT-NAME>V2xDM</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the V2XDM module</L-2>
              </DESC>
              <ADMIN-DATA>
                <DOC-REVISIONS>
                  <DOC-REVISION>
                    <REVISION-LABEL>4.10.0</REVISION-LABEL>
                    <ISSUED-BY>AUTOSAR</ISSUED-BY>
                  </DOC-REVISION>
                </DOC-REVISIONS>
              </ADMIN-DATA>
              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00001</RELATED-TRACE-ITEM-REF>
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
