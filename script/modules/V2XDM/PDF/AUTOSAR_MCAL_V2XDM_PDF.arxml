              <CONTAINERS>
                <!-- Container Definition: V2xDMConfigSet -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9d22ae88-56cd-4d38-a499-d48203689511">
                  <SHORT-NAME>V2xDMConfigSet</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Container contains all configuration items for the V2xDM</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00086</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <SUB-CONTAINERS>
                    <!-- Container Definition: V2xDMCatalogItem -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:929acf4d-3ee4-4325-b065-13d413eb71cf">
                      <SHORT-NAME>V2xDMCatalogItem</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Contains all catalog items of the V2x DataManager</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00065</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
