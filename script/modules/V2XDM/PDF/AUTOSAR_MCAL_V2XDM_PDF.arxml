                      <MIN INTERVAL-TYPE="OPEN">0</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: V2xDMVersionInfoApi -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7fde2cf3-1614-4ce1-8f14-411f7781f5de">
                      <SHORT-NAME>V2xDMVersionInfoApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enable/disables the API for reading the version information of the V2xDM Module.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: enabled (ON) * false: disabled (OFF)</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00004</RELATED-TRACE-ITEM-REF>
