                        <L-2 L="EN">Specifies the period of main function V2xDM_MainFunction in seconds.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00020</RELATED-TRACE-ITEM-REF>
