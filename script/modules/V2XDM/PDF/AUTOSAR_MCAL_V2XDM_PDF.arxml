                    <!-- PARAMETER DEFINITION: V2xDMDevErrorDetect -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1d701d62-bdd3-40d8-8c56-3b9f2795fb4e">
                      <SHORT-NAME>V2xDMDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: enabled (ON) * false: disabled (OFF)</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00003</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
