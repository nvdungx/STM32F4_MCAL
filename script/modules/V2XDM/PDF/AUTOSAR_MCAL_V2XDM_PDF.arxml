                  <DESC>
                    <L-2 L="EN">This container contains the general configuration parameters of the Vehicle-2-X Data Manager.</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00002</RELATED-TRACE-ITEM-REF>
