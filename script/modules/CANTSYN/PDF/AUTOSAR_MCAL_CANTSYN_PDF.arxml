                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <REQUIRES-SYMBOLIC-NAME-VALUE>true</REQUIRES-SYMBOLIC-NAME-VALUE>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/StbM/StbMFreshnessValueInformation/StbMFreshnessValue</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                            <!-- Symbolic Name Reference Definition: CanTSynIcvGenerationJobRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:ec253753-cb31-4ffa-9b49-a6f4b1e9328b">
                              <SHORT-NAME>CanTSynIcvGenerationJobRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This represents the reference to the CSM job to fetch the CSM job ID.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00064</RELATED-TRACE-ITEM-REF>
