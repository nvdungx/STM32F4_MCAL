                        <!-- Container Definition: CanTSynGlobalTimeRxIcvVerification -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9309b1e5-5ca6-45dc-a275-e6e59af60197">
                          <SHORT-NAME>CanTSynGlobalTimeRxIcvVerification</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container collects configuration required for ICV verification.</L-2>
                          </DESC>
