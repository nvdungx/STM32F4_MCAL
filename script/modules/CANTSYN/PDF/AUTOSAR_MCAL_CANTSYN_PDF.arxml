                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4ecf3359-e7ad-478f-8345-5e7d0b6acdf4">
                              <SHORT-NAME>CanTSynRxAuthenticationBuildAttempts</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter specifies the number of authentication build attempts that are to be carried out when the verification of the ICV failed for a given FUP message. If zero is set, then only one ICV verification attempt is done.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00084</RELATED-TRACE-ITEM-REF>
