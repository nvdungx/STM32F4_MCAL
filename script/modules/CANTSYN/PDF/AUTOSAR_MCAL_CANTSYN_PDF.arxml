                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: CanTSynGlobalTimePropagationDelay -->
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:7eee68af-a643-4554-8a72-5407980e4718">
                              <SHORT-NAME>CanTSynGlobalTimePropagationDelay</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Physical Layer specific propagation delay of a SYNC message to be compensated upon SYNC reception. Unit: seconds.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00089</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
