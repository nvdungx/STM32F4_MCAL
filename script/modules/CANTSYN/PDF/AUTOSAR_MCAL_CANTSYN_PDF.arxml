                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:12f87f90-00d7-4f10-82ed-d18196eeb636">
                              <SHORT-NAME>CanTSynIcvVerificationAttempts</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter specifies the number of ICV verification attempts that are to be carried out when the verification of the ICV failed for a given FUP message. If zero is set, then only one ICV verification attempt is</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">done.</L-1>
                                </P>
                              </INTRODUCTION>
