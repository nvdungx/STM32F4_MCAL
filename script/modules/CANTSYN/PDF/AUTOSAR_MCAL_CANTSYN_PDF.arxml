                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: CanTSynUseExtendedMsgFormat -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e212434b-42cb-4ce2-96b1-4ac324375d34">
                      <SHORT-NAME>CanTSynUseExtendedMsgFormat</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches support for 16 Byte Timesync messages on or off (for CAN FD only)</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: CAN FD support is active: use at least 16 byte for Timesync messages (depending on configuration) * false: Classic CAN support is active: use always 8 byte for Timesync messages</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00042</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
