                            <!-- PARAMETER DEFINITION: CanTSynIcvVerificationTimeout -->
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:e4a28291-0b1e-4a95-8411-4869d32b35b6">
                              <SHORT-NAME>CanTSynIcvVerificationTimeout</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Timeout of ICV generation (respective CSM job completion in asynchronous behavior). A value of 0 disables the ICV timeout monitoring. Unit: Seconds</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00081</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
