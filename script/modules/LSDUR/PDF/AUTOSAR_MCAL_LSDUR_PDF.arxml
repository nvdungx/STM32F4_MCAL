                <!-- Container Definition: LSduRGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a78cf23b-e27d-4b2a-956d-982bc6120c22">
                  <SHORT-NAME>LSduRGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Specifies the general configuration parameters of the LSduR.</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LSduR_00002</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
