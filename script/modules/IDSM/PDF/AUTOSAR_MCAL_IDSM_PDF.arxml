                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00063</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
