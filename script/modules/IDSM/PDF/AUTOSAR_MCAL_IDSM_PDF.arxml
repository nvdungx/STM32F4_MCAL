                        <!-- Reference Definition: IdsMFilterChainRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:897a0dde-a85c-4d79-80fa-1349fb0efdd5">
                          <SHORT-NAME>IdsMFilterChainRef</SHORT-NAME>
                          <DESC>
