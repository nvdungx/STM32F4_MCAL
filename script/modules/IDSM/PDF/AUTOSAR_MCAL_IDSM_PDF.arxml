                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:960e8aa4-56f7-4c8f-9a50-bb8abfc985d1">
                          <SHORT-NAME>IdsMIfTxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">IF PDU used to transmit a QSEv via the PduR to the IdsR.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
