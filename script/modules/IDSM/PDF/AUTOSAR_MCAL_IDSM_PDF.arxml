                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/IdsM/IdsMConfiguration/IdsMFilterChain</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
                      <SUB-CONTAINERS>
                        <!-- Container Definition: IdsMContextDataModifierOptions -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a74e37ce-02cf-4995-8725-dd3680f94dd4">
                          <SHORT-NAME>IdsMContextDataModifierOptions</SHORT-NAME>
                          <DESC>
