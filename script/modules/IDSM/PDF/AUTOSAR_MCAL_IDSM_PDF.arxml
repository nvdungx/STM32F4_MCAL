                      <SHORT-NAME>IdsMSignatureSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter enables/disables the functionality of sending messages to the network with a signature of encryption calculated by the crypto services.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00009</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
