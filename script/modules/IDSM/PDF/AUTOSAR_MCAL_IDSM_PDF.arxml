                        <!-- Container Definition: IdsMTpTxPdu -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:df65cd55-d05d-4f34-a277-11289bd8b1ca">
                          <SHORT-NAME>IdsMTpTxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">TP PDU used to transmit a QSEv via the PduR to the IdsR.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
