                              <SHORT-NAME>IdsMIfTxPduRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the IF PDU used for transmission of the QSEvs.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
