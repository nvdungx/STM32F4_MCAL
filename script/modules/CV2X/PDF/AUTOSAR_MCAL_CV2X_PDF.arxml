                  <SHORT-NAME>CV2xGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">General Configuration of Cellular V2X Driver</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CV2x_00002</RELATED-TRACE-ITEM-REF>
