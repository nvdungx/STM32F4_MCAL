                      <REFERENCES>
                        <!-- Reference Definition: CV2xCtrlEcucPartitionRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:7caa33d1-746d-41bc-ae42-af2f4855444f">
                          <SHORT-NAME>CV2xCtrlEcucPartitionRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maps the Cellular V2X controller to zero or one ECUC partitions.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">The ECUC partition referenced is a subset of the ECUC partitions where the Cellular V2X driver is mapped to.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CV2x_00015</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
