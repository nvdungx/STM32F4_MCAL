                  <PARAMETERS>
                    <!-- PARAMETER DEFINITION: CnV2xMsgV2xDmServiceConfig -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:82cb931e-14f8-40c7-a4ed-658a189885f1">
                      <SHORT-NAME>CnV2xMsgV2xDmServiceConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enable/disables the messages reception service via V2xDm.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">- true: enabled (ON) - false: disabled (OFF)</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CnV2xMsg_00021</RELATED-TRACE-ITEM-REF>
