                <!-- Container Definition: CnV2xMsgConfig -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1df25598-de64-483c-bc8c-2ea00ef1dca5">
                  <SHORT-NAME>CnV2xMsgConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container contains the configuration parameters of the BSW module CnV2xMsg.</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
