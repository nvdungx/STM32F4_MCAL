                    <!-- Container Definition: CnV2xNetTxPdu -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3b06f47c-d5b0-4411-8da7-efe439adfe17">
                      <SHORT-NAME>CnV2xNetTxPdu</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Represents the transmitted PDU. This PDU is usually linked to the EthIf via LSduR. It produces meta data items of the type ETHERNET_MAC_64.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CnV2xNet_00012</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: CnV2xNetTxPduId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:efc57084-0562-4177-92a5-8db074a3aa04">
