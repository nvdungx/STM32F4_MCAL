                      <SHORT-NAME>CnV2xNetTxConfirmation</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">When enabled, transmission status information will be forwarded to the upper layer.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">- true: enabled (ON) - false: disabled (OFF)</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CnV2xNet_00006</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
