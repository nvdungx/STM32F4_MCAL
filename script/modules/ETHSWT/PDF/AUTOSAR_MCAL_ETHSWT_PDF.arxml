                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: EthSwtPortPriorityToTrafficClassAssignmentPriority -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:766f5747-d746-4b01-baa6-96fba9af994b">
                                  <SHORT-NAME>EthSwtPortPriorityToTrafficClassAssignmentPriority</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the priority derived from the Ethernet frame, which is used to determine the corresponding traffic class, where this Ethernet frame shall be assigned to. The upper value range is restricted to the configured value of EthSwtUsedInternalPriorityUpperValue.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthSwt_00249</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>4294967295</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: EthSwtPortPriorityToTrafficClassAssignmentTrafficClass -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9251b717-94ad-4c1b-925f-3160a7229793">
                                  <SHORT-NAME>EthSwtPortPriorityToTrafficClassAssignmentTrafficClass</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the traffic class value where an Ethernet frame, with the corresponding priority, is assigned to. The upper value range is restricted to the configured value of EthSwtUsedTrafficClassUpperValue.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
