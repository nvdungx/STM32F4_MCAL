                        <ECUC-REFERENCE-DEF UUID="ECUC:933de0dd-8c7e-4205-a00f-7eaf4fc50d9b">
                          <SHORT-NAME>EthSwtDestPortsForUnknownMulticastMacDestAddressRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the egress ports frames with unknown multicast MAC destination addresses (without a matching ARL entry) are forwarded on.</L-2>
                          </DESC>
