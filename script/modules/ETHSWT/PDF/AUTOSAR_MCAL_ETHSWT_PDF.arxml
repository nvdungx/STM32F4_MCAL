                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: EthSwtVlanMembership -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d3396b6d-b67c-46aa-a5d4-b030ab5ab29b">
                      <SHORT-NAME>EthSwtVlanMembership</SHORT-NAME>
