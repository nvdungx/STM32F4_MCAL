                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d14d60d6-a548-4183-a954-a715f79cda06">
                                  <SHORT-NAME>EthSwtPortIngressVlanTranslationTableEntry</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container defines the mapping between the IngressVlanID (VlanID read from the received frame upon ingress) and the corresponding TranslatedVlanID upon ingress Vlan translation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthSwt_00257</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
