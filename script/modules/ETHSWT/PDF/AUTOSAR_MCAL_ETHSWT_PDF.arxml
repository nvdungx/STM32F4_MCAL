                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:4e0b90c2-142f-4599-9ac1-b77f78c77b4c">
                              <SHORT-NAME>EthSwtVlanForwardingType</SHORT-NAME>
                              <DESC>
