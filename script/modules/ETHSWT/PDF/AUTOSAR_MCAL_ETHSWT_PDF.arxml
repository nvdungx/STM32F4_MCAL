                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:637d1f08-47ac-4148-8fa6-f84cbeb2a7ea">
                                      <SHORT-NAME>EthSwtStreamFilterEntryPosition</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Specifies the position as unique ID within an ordered list of EthSwtStreamFilterEntrys. The ordered list shall start with 0 and continue as linear list with no gaps.</L-2>
                                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Note: The list is processed in ascending order. The instance of EthSwtStreamFilterEntry with position 0 is processed first.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthSwt_00216</RELATED-TRACE-ITEM-REF>
