                        </ECUC-REFERENCE-DEF>
                        <!-- Reference Definition: EthSwtDestPortsForUnknownUnicastMacDestAddressRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:3e6192ed-0bba-43b1-96ed-eb9527a23e40">
                          <SHORT-NAME>EthSwtDestPortsForUnknownUnicastMacDestAddressRef</SHORT-NAME>
                          <DESC>
