                        <!-- Container Definition: J1939FscpShmRxPdu -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d2f093e4-4dcb-48fa-9f10-f1750568ee8b">
                          <SHORT-NAME>J1939FscpShmRxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Contains the configuration of the PDU used to receive the SHM PG.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
