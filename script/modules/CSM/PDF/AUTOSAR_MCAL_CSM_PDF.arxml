                  <SUB-CONTAINERS>
                    <!-- Container Definition: CsmInOutRedirection -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e6cb58d4-2140-4201-a9d9-eba18764686d">
