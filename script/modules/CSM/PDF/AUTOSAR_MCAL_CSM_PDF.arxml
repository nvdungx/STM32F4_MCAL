                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:bef00fa6-1f90-4670-b862-46910dabd28a">
                          <SHORT-NAME>CsmDecryptConfig</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Container for configuration of a CSM decryption interface. The container name serves as a symbolic name for the identifier of an decryption interface.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Csm_00064</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: CsmDecryptAlgorithmFamily -->
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:8821f6ed-48f7-4db5-b504-2e77420cf617">
                              <SHORT-NAME>CsmDecryptAlgorithmFamily</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Determines the algorithm family used for the crypto service. This parameter defines the most significant part of the algorithm.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Csm_00066</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
