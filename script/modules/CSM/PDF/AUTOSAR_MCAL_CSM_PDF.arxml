                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Csm/CsmInOutRedirections/CsmInOutRedirection</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
