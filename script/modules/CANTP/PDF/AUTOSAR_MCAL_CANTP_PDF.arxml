                                  <SHORT-NAME>CanTpNTa</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter contains the transport protocol target address value.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00255</RELATED-TRACE-ITEM-REF>
