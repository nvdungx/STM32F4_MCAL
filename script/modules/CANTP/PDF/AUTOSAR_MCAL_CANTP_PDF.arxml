                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: CanTpRxFcNPdu -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0f204774-e365-43f9-b770-fb106ee7ee72">
                              <SHORT-NAME>CanTpRxFcNPdu</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Used for grouping of the ID of a PDU and the Reference to a PDU. This N-PDU consumes a meta data item of type CAN_ID_32.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00271</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: CanTpRxFcNPduId -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4e87ce7d-00bc-4a88-b1b5-daa96e41b0e1">
                                  <SHORT-NAME>CanTpRxFcNPduId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">N-PDU identifier attached to the FC N-PDU of this TxNsdu identified by CanTpTxNSduId.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Each TxNsdu identifier is linked to one Rx FC N-PDU identifier only. However, in the case of extended addressing format, the same FC N-PDU identifier can be used for several N-SDU identifiers. The distinction is made by means of the N_TA value (first data byte of FC frames).</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00273</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                  <WITH-AUTO>true</WITH-AUTO>
                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <!-- Reference Definition: CanTpRxFcNPduRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:1d5ecce4-71e5-44df-92a3-5411a32d0f8b">
                                  <SHORT-NAME>CanTpRxFcNPduRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00272</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
