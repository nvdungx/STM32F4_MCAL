                                  <SHORT-NAME>CanTpNAe</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter contains the transport protocol address extension value.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00285</RELATED-TRACE-ITEM-REF>
