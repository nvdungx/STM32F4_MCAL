                    <!-- PARAMETER DEFINITION: CanTpDevErrorDetect -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d7ad678b-0f30-45a2-b3c2-dd92c02c073e">
                      <SHORT-NAME>CanTpDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the development error detection and notification on or off.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: detection and notification is enabled. * false: detection and notification is disabled.</L-1>
                        </P>
                      </INTRODUCTION>
