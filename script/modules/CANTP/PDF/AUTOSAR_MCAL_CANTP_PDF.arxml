                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                          <SUB-CONTAINERS>
                            <!-- Container Definition: CanTpNAe -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a1afb169-0892-9426-5aed-cc51db16ccf1">
                              <SHORT-NAME>CanTpNAe</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container is required for each RxNSdu and TxNSdu with AddressingFormat CANTP_MIXED or CANTP_MIXED29BIT.</L-2>
                              </DESC>
