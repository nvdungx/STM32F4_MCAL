                      <SUB-CONTAINERS>
                        <!-- Container Definition: KeyMCertificateCustomService -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6e41b186-dcb4-42fe-ba72-abaa4a0d947d">
                          <SHORT-NAME>KeyMCertificateCustomService</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The presence of this container defines the custom processing for this certificate.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_KeyM_00085</RELATED-TRACE-ITEM-REF>
