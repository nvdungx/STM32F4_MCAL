                          <SHORT-NAME>KEYM_VERIFY_AEADENCRYPT</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:68014a02-2bf7-91fb-09f8-4e78d440ab96">
