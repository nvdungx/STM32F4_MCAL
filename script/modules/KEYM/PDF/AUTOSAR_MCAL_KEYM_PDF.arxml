                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <REFERENCES>
                            <!-- Symbolic Name Reference Definition: KeyMCertCsmCustomJobRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:7bb5f6e1-0b87-4221-b039-f5bf862b5d46">
                              <SHORT-NAME>KeyMCertCsmCustomJobRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the CSM job that is used to process the custom actions.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_KeyM_00086</RELATED-TRACE-ITEM-REF>
