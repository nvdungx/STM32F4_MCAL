                  <DESC>
                    <L-2 L="EN">General configuration of Ethernet Driver module</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00001</RELATED-TRACE-ITEM-REF>
