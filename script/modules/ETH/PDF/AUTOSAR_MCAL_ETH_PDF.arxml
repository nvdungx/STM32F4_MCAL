                              <SHORT-NAME>EthCtrlConfigSpiEnableRxCutThrough</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">When supported by the HW, enables the cut through mode of frame from the network to the SPI host.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00082</RELATED-TRACE-ITEM-REF>
