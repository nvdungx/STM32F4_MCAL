                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <REFERENCES>
                            <!-- Symbolic Name Reference Definition: MKA_E_ALGO_MISMATCH_INSTANCE -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:f6140149-1b62-472b-80df-d29d9f209a84">
                              <SHORT-NAME>MKA_E_ALGO_MISMATCH_INSTANCE</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the DemEventParameter which shall be issued when the MkaKay Instance does not successfully agree on MACsec keys and at least one MkaKayParticipant does not support a common MACsec cipher suite.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00059</RELATED-TRACE-ITEM-REF>
