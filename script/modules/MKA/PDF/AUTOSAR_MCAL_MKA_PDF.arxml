                    <!-- PARAMETER DEFINITION: MkaRetryBaseDelay -->
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:1c490294-a686-4caa-83c2-cfcc732128c4">
                      <SHORT-NAME>MkaRetryBaseDelay</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The base delay in seconds for the retry phase of MKA.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">The retry have an exponential back off delay (1x base delay, 2x base delay, 4x base delay, ...) until the retry delay overflows the MkaRetryCyclicDelay value.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00004</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
