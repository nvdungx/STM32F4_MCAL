    <AR-PACKAGE UUID="ECUC:AUTOSAR">
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <!-- AR-Package: AUTOSAR -->
        <AR-PACKAGE UUID="ECUC:ECUCDEFS">
          <SHORT-NAME>EcucDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-DEFINITION-COLLECTION UUID="ECUC:4c30de73-30fc-43b3-a1b3-e74211eedff3">
              <SHORT-NAME>AUTOSARParameterDefinition</SHORT-NAME>
              <MODULE-REFS>
                <MODULE-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Mka</MODULE-REF>
              </MODULE-REFS>
            </ECUC-DEFINITION-COLLECTION>
            <!-- Module Definition: Mka -->
            <ECUC-MODULE-DEF UUID="ECUC:2547cebe-1ab4-4f6a-bed7-5872899b43df">
              <SHORT-NAME>Mka</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the MACsec Key Agreement module.</L-2>
                <L-2 L="EN">Tags: atp.Status=draft</L-2>
              </DESC>
              <ADMIN-DATA>
                <DOC-REVISIONS>
                  <DOC-REVISION>
                    <REVISION-LABEL>4.10.0</REVISION-LABEL>
                    <ISSUED-BY>AUTOSAR</ISSUED-BY>
                  </DOC-REVISION>
                </DOC-REVISIONS>
              </ADMIN-DATA>
              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00001</RELATED-TRACE-ITEM-REF>
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <POST-BUILD-VARIANT-SUPPORT>false</POST-BUILD-VARIANT-SUPPORT>
              <SUPPORTED-CONFIG-VARIANTS>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
              </SUPPORTED-CONFIG-VARIANTS>
              <CONTAINERS>
                <!-- Container Definition: MkaCryptoAlgoConfig -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f41d1abb-ecb6-40b2-96a4-920781909b8f">
                  <SHORT-NAME>MkaCryptoAlgoConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Cryptography configuration for MACsec.</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00021</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <PARAMETERS>
                    <!-- PARAMETER DEFINITION: MkaCryptoAlgoConfigIdx -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b8644399-5e37-409c-a5c1-70624192a878">
                      <SHORT-NAME>MkaCryptoAlgoConfigIdx</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Instance ID of the configured Crypto configuration.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00053</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaMacSecCapability -->
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:ebdb7ac9-a117-4450-8c5c-77c31923378e">
                      <SHORT-NAME>MkaMacSecCapability</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">MACsec capability to use for MACsec.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00025</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>INTEGRITY_WITHOUT_CONFIDENTIALITY</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8763f444-8c4d-858b-321d-bc1062477380">
                          <SHORT-NAME>INTEGRITY_AND_CONFIDENTIALITY</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ce13b8e3-78fe-8cf3-52be-476735c6788d">
                          <SHORT-NAME>INTEGRITY_WITHOUT_CONFIDENTIALITY</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaMacSecConfidentialityOffset -->
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:5f474488-ad64-470f-a31d-31a20471538e">
                      <SHORT-NAME>MkaMacSecConfidentialityOffset</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The confidentiality Offset is only applicable if "Integrity and confidentiality" with a non-XPN cipher suite is selected.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00026</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CONFIDENTIALITY_OFFSET_0</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:9fd71dfd-c27a-834f-3b3e-fcfc44dbe55d">
                          <SHORT-NAME>CONFIDENTIALITY_OFFSET_0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d27ee27a-4b10-8e97-3221-bb0df9141919">
                          <SHORT-NAME>CONFIDENTIALITY_OFFSET_30</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c1a233d3-e35f-87c1-3999-fffc0b3382a1">
                          <SHORT-NAME>CONFIDENTIALITY_OFFSET_50</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaMacSecReplayProtection -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:44641ad7-e89a-49b7-bdd0-8bcfcea6ddad">
                      <SHORT-NAME>MkaMacSecReplayProtection</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">MACsec replay protection parameter for MACsec.\newline The Replay Protection parameter is defined in the IEEE 802.1AE-2018 document, on chapter 10.4. It enables the replay protection if a packet is received with PacketNumber outside of the Window = PN - ProtectionWindow.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00027</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaMacSecReplayProtectionWindow -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b6e5fd52-126a-4fab-bbaa-959ada4e53b7">
                      <SHORT-NAME>MkaMacSecReplayProtectionWindow</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">In case replay protection is active, replay protection window.The Protection Window is a positive integer between 0 and 2^32-1 (No XPN) or 2^30-1 (XPN).</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00028</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>18446744073709551615</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <!-- Container Definition: MkaCipherSuites -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9ddc4d62-f852-4c69-9299-63a30b334410">
                      <SHORT-NAME>MkaCipherSuites</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Cipher Suite configuration to use with MACsec.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">MkaCipherSuitePrio is present in case the MKA instance acts as a Key Server to select the cipher suite to use for MACsec.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00050</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>4</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: MkaMacSecCipherSuite -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:50744e26-2595-4ba4-81b3-f95368d0730b">
                          <SHORT-NAME>MkaMacSecCipherSuite</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Cipher Suite to use for MACsec.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00052</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>GCM_AES_128</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:68cd6f6c-0e41-9164-2100-12ad9e311367">
                              <SHORT-NAME>GCM_AES_128</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d85b61d3-e968-96f5-13b6-300c4321570a">
                              <SHORT-NAME>GCM_AES_256</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8150583b-9e3f-9078-3026-e93b9c7985f0">
                              <SHORT-NAME>GCM_AES_XPN_128</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8e889ecd-2bb8-9b14-1381-00d80c5cf891">
                              <SHORT-NAME>GCM_AES_XPN_256</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: MkaMacSecCipherSuitePrio -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7b3105d8-c259-441a-ace8-f3ce02ef27c6">
                          <SHORT-NAME>MkaMacSecCipherSuitePrio</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">In case the MKA instance acts as a Key Server, the priority is used to select the Cipher Suite to use with MACsec from the common supported Ciphers (with the client in the link).</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Value of 1 means the highest priority. Value of 4 means the lowest priority.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00051</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>4</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <!-- Container Definition: MkaGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6c3a1fce-2b96-4356-a245-017ee3c8d1fa">
                  <SHORT-NAME>MkaGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container holds the general parameters of the MKA protocol which apply to ports that are referencing this container.</L-2>
                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00002</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <PARAMETERS>
                    <!-- PARAMETER DEFINITION: MkaDevErrorDetect -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:21cb9a6f-6311-4b20-9216-7b00506f3264">
                      <SHORT-NAME>MkaDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the development error detection and notification on or off.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">- true: detection and notification is enabled. . false: detection and notification is disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00034</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaEnableSecurityEventReporting -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:93a815f7-da76-4ca2-b662-12a3bb2e3912">
                      <SHORT-NAME>MkaEnableSecurityEventReporting</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the reporting of security events to the IdsM:</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">- true: reporting is enabled. - false: reporting is disabled</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00061</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaHelloTime -->
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ce0c73f8-9589-4f50-a12f-35eacb4df8ea">
                      <SHORT-NAME>MkaHelloTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Interval [s] between MKPDUs when two participants have an active MKA communication (the participants are included in the Live Peer list of each other).</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00007</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>2</DEFAULT-VALUE>
                      <MAX INTERVAL-TYPE="CLOSED">INF</MAX>
                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: MkaLifeTime -->
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:2d9ca11b-f6f9-461d-af8d-aeb1a4df56dd">
                      <SHORT-NAME>MkaLifeTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Time span [s] since last MKPDU was received from the other participant, to consider it alive.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">\newline In case no valid MKPDU from the other participant is received after MkaLifeTime, the Secure Channel is shut down.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00009</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
