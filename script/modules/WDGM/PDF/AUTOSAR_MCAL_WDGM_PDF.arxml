                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f25db5c0-5a1a-49a2-814c-0cea1de8c551">
                          <SHORT-NAME>WdgMCheckpoint</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container collects all Checkpoints of this Supervised Entity. Each Supervised Entity has at least one Checkpoint.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00305</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: WdgMCheckpointId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2f217747-69c5-4c3c-8c30-98b776f7127b">
                              <SHORT-NAME>WdgMCheckpointId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter shall contain the unique identifier of Checkpoint.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00306</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
