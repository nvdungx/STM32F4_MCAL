                                  <SHORT-NAME>WdgMResourceRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the CpSoftwareClusterServiceResource.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00367</RELATED-TRACE-ITEM-REF>
