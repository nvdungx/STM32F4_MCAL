                                  <DESTINATION-TYPE>CP-SOFTWARE-CLUSTER-SERVICE-RESOURCE</DESTINATION-TYPE>
                                </ECUC-FOREIGN-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
