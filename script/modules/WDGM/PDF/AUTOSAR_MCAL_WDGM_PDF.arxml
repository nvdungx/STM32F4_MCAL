                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- Reference Definition: WdgMTriggerWatchdogRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:8f3d8b0f-8da6-4cf4-8ca0-31c89ffc4670">
                              <SHORT-NAME>WdgMTriggerWatchdogRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter is a reference to the configured watchdog.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00334</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
