                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7d6e9106-a46c-42f7-8099-2b025b6928f1">
                          <SHORT-NAME>WdgMLocalStatusParams</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container collects all configuration parameters for the Local Status of a Supervised Entity.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00325</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: WdgMFailedAliveSupervisionRefCycleTol -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:19ecddaa-c38c-4575-a851-33956ce42842">
                              <SHORT-NAME>WdgMFailedAliveSupervisionRefCycleTol</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter shall contain the acceptable amount of reference cycles with incorrect/failed alive supervisions for this Supervised Entity.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00327</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
