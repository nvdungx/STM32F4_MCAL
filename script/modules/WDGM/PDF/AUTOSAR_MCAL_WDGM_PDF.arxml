                          <REFERENCES>
                            <!-- Symbolic Name Reference Definition: WdgMInternalTransitionDestRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:741dd3c3-e647-4757-9154-9dba9ce5150e">
                              <SHORT-NAME>WdgMInternalTransitionDestRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This is the reference to the destination Checkpoint of a Internal Transition within this Supervised Entity.</L-2>
                              </DESC>
