                                  <SHORT-NAME>IKESignatureLength</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">The length of a signature generated by the configured generation job and verified by the configured verification job.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">E.g. 64 for ECDSA-256 or 96 for ECDSA-386.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IKE_00085</RELATED-TRACE-ITEM-REF>
