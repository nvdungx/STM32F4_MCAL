                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c5bfa68d-6acc-4aca-9873-009bba6f821f">
                      <SHORT-NAME>IEEE1722TpDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the development error detection and notification on or off.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: detection and notification is enabled. * false: detection and notification is disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IEEE1722Tp_00003</RELATED-TRACE-ITEM-REF>
