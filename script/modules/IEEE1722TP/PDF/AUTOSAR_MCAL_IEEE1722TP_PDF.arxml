                        <!-- PARAMETER DEFINITION: IEEE1722TpStreamIdUniquePart -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7ec43385-ac00-4284-bac2-cf0fc0fabbc5">
                          <SHORT-NAME>IEEE1722TpStreamIdUniquePart</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Definition of the unique ID part of the Stream Id.</L-2>
