                              <MAX>65535</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- Reference Definition: IEEE1722TpLowerLayerTxPduRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:887e3b06-3e3e-4fe4-b93d-11a2c1f89bba">
                              <SHORT-NAME>IEEE1722TpLowerLayerTxPduRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the EcuC Pdu used for the transport of Tx Pdu to the lower layer.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IEEE1722Tp_00026</RELATED-TRACE-ITEM-REF>
