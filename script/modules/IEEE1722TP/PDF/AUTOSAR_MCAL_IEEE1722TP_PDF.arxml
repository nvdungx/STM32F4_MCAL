                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: IEEE1722TpStreamIdMacAddress -->
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:29d13073-b90b-4d50-a90f-f710e0db236a">
                          <SHORT-NAME>IEEE1722TpStreamIdMacAddress</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Definition of the MAC address part of the Stream Id.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
