                                <!-- PARAMETER DEFINITION: IEEE1722TpStreamAcfMixedBusTypeCollection -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c306d633-e490-4194-b969-f583f90801fc">
                                  <SHORT-NAME>IEEE1722TpStreamAcfMixedBusTypeCollection</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines if this ACF-stream is allowed to collect ACF-messages of different bus kinds (i.e. whether it is allowed to collect CAN and LIN ACF-messages in one ACF-stream message).</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">For the ACF-stream producer this configures the collection behavior. For an ACF-stream consumer this configures that this ACF-stream was produced with this assumption. true = 1: mixed collection is allowed false = 0 : mixed collection is not allowed</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IEEE1722Tp_00110</RELATED-TRACE-ITEM-REF>
