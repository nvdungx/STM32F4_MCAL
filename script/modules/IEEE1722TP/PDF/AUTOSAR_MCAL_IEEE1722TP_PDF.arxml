                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:d0704c3d-b622-43cf-873c-a793e1e20f53">
                                                  <SHORT-NAME>IEEE1722TpStreamAcfCanIdMask</SHORT-NAME>
                                                  <DESC>
                                                    <L-2 L="EN">Identifier mask which denotes relevant bits in the CAN Identifier. This parameter defines a CAN Identifier range in an alternative way to IEEE1722TpStreamAcfCanIdRange. It identifies the bits of the configured CAN Identifier that must match the received CAN Identifier.</L-2>
                                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                                  </DESC>
                                                  <INTRODUCTION>
                                                    <P>
                                                      <L-1 L="EN">Range: 11 bits for Standard CAN Identifier, 29 bits for Extended CAN Identifier.</L-1>
                                                    </P>
                                                  </INTRODUCTION>
                                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IEEE1722Tp_00083</RELATED-TRACE-ITEM-REF>
                                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
