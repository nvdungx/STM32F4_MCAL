                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:7da4fa11-0f71-4bbb-8041-813fe7055af9">
                      <SHORT-NAME>EthTSynGlobalTimeRxDebounceTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This represents the configuration of a RX debounce time for Sync and Follow_Up. Unit: seconds</L-2>
                      </DESC>
