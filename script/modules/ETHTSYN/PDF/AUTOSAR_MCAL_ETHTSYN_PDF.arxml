                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: EthTSynCrcCorrectionField -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6458078f-308c-9762-0cc5-947ad3ef3b72">
                                  <SHORT-NAME>EthTSynCrcCorrectionField</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">correctionField from the Follow_Up Message Header shall be included in CRC calculation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00042</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: EthTSynCrcDomainNumber -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2b184225-a081-8b9c-440f-385e0739e43d">
                                  <SHORT-NAME>EthTSynCrcDomainNumber</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">domainNumber from the Follow_Up Message Header shall be included in CRC calculation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00041</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: EthTSynCrcMessageLength -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bd46fb52-c29e-9a2a-09a8-f0620e2203f1">
                                  <SHORT-NAME>EthTSynCrcMessageLength</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">messageLength from the Follow_Up Message Header shall be included in CRC calculation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00040</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: EthTSynCrcPreciseOriginTimestamp -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e6475574-5a20-9738-1808-4edf24308a2b">
                                  <SHORT-NAME>EthTSynCrcPreciseOriginTimestamp</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">preciseOriginTimestamp from the Follow_Up Message Field shall be included in CRC calculation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00045</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: EthTSynCrcSequenceId -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8ade3424-79bd-8b78-1a92-99d8a0aadaa0">
                                  <SHORT-NAME>EthTSynCrcSequenceId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">sequenceId from the Follow_Up Message Header shall be included in CRC calculation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00044</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
