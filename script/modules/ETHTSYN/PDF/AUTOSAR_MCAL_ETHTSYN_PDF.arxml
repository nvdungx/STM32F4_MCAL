                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: EthTSynGlobalTimeFollowUpDataIDListIndex -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:55411683-3e13-4d90-98d6-99505fa5a5c1">
                              <SHORT-NAME>EthTSynGlobalTimeFollowUpDataIDListIndex</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Index of the DataIDList for Follow_Up message ensures the identification of data elements due to CRC calculation and message authentication process.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTSyn_00032</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
