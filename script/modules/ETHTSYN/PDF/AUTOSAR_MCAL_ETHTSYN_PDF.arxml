                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:02a18ef2-cba3-4e31-9cb4-289dae7bffec">
                          <SHORT-NAME>EthTSynGlobalTimeFollowUpDataIDListElement</SHORT-NAME>
                          <DESC>
