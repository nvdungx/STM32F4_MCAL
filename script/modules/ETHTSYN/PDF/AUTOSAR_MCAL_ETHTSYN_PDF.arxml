                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:84fd9383-b7af-4092-82c7-a5f6f041d4ba">
                              <SHORT-NAME>EthTSynIcvGenerationBase</SHORT-NAME>
                              <DESC>
