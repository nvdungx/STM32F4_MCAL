                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <!-- Container Definition: EthIfFrameRxPool -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d8808afd-c0d5-46fa-bd63-2927a670050e">
                          <SHORT-NAME>EthIfFrameRxPool</SHORT-NAME>
