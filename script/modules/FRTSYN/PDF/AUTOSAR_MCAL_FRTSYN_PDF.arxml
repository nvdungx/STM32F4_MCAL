                            <!-- PARAMETER DEFINITION: FrTSynIcvVerificationTimeout -->
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:29cb9eb1-68e2-4ec9-8a0a-d4849db313df">
                              <SHORT-NAME>FrTSynIcvVerificationTimeout</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Timeout of ICV verification (respective CSM job completion in asynchronous behaviour). A value of 0 disables the ICV timeout monitoring. Unit: Seconds</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrTSyn_00061</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
