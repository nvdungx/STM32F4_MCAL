                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4543db85-68dc-481d-bcf5-224358ce207d">
                              <SHORT-NAME>FrTSynGlobalTimeSlaveHandleId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This represents the handle ID of the PDU that contains the global time information.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrTSyn_00011</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
