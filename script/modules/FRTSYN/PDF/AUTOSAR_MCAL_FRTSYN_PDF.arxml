                              <MAX INTERVAL-TYPE="OPEN">INF</MAX>
                              <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: FrTSynRxAuthenticationBuildAttempts -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9b9630bf-dc1b-4946-9b24-ac4758c58059">
                              <SHORT-NAME>FrTSynRxAuthenticationBuildAttempts</SHORT-NAME>
