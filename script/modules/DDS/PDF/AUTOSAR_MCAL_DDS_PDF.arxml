                            <ECUC-REFERENCE-DEF UUID="ECUC:f15472dc-43db-4f18-92b8-3b13d9c2d177">
                              <SHORT-NAME>DdsAppDataTxPduRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The reference to a PDU in the global PDU structure described in the AUTOSAR ECU Configuration Specification.</L-2>
                              </DESC>
