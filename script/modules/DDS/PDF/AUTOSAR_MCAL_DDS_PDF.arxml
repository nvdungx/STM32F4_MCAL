                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f6f63a72-d05c-4481-a66f-ebfb46617a9d">
                          <SHORT-NAME>DdsAppDataTxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The upper layer PDU used to transmit data from Application to DDS itself.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dds_00132</RELATED-TRACE-ITEM-REF>
