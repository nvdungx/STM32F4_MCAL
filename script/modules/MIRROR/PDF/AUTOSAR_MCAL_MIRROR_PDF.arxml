                            <!-- PARAMETER DEFINITION: MirrorDestTransmissionDeadline -->
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:562af67e-138f-920f-4b28-98fc2fa17091">
                              <SHORT-NAME>MirrorDestTransmissionDeadline</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Time in seconds after which the collection of source frames into the destination frame stopped and the frame is sent at the latest.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">If omitted, destination frames are only sent when full or when the time stamp overflows after 655.35ms.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mirror_00059</RELATED-TRACE-ITEM-REF>
