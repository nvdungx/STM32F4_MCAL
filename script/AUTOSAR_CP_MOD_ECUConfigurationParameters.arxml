                    <!-- Container Definition: FrTSynGlobalTimeSyncDataIDList -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a62732c8-a61d-477f-89f0-10590b2d8a7d">
                      <SHORT-NAME>FrTSynGlobalTimeSyncDataIDList</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The DataIDList for SYNC messages ensures the identification of data elements due to CRC calculation and message authentication process.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrTSyn_00023</RELATED-TRACE-ITEM-REF>
