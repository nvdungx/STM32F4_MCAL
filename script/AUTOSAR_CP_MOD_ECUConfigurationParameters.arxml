                                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dcm/DcmConfigSet/DcmDsl/DcmDslProtocol/DcmDslProtocolRow/DcmDslConnection/DcmDslPeriodicTransmission</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
                                        <!-- Symbolic Name Reference Definition: DcmDslProtocolComMChannelRef -->
                                        <ECUC-REFERENCE-DEF UUID="ECUC:855610d2-6cfe-4554-af1b-1642fe0b6c4d">
                                          <SHORT-NAME>DcmDslProtocolComMChannelRef</SHORT-NAME>
