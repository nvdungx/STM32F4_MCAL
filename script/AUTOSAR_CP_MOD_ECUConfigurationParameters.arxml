                    <!-- PARAMETER DEFINITION: IcuTimestampApi -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b4d200cd-fefe-4c78-8338-cccedb398ee1">
                      <SHORT-NAME>IcuTimestampApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Adds / removes all services related to the timestamping functionality as listed below from the code: Icu_StartTimestamp(), Icu_StopTimestamp(), Icu_GetTimestampIndex().</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true: The services listed above can be used. false: The services listed above can not be used.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Icu_00123</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
