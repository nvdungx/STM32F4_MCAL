                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c28b70e9-e868-42de-ad5e-1b08412a6faa">
                          <SHORT-NAME>TcpIpTcpWindowScaleOptionEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines if the TCP window scale option and mechanism shall be supported according to IETF RFC 7323, chapter 2.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
