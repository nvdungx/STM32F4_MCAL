                <!-- Container Definition: WEthGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7e7f37ca-3b82-4d90-84cc-ee34dfba7b7f">
                  <SHORT-NAME>WEthGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">General configuration of Wireless Ethernet Driver module.</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WEth_00001</RELATED-TRACE-ITEM-REF>
