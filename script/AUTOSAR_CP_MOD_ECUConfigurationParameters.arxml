                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: FrNmUserDataTxPdu -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4d810673-368e-4375-bc96-e41197a52b50">
                              <SHORT-NAME>FrNmUserDataTxPdu</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This optional container is used to configure the UserNm PDU. This container is only available if FrNmComUserDataSupport is enabled.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrNm_00055</RELATED-TRACE-ITEM-REF>
