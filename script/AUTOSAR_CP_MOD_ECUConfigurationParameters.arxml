                            <!-- PARAMETER DEFINITION: EthClkUnitIdx -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4cc6d08b-dcdf-402e-a601-669dc863a2b1">
                              <SHORT-NAME>EthClkUnitIdx</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Zero-based consecutive index of the HW clock units in the Ethernet Controller. Upper layer BSW modules and the Eth itself use this index to identify a clock in the Ethernet Controller.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00118</RELATED-TRACE-ITEM-REF>
