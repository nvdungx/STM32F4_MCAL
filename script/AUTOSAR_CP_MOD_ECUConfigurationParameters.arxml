                        <!-- PARAMETER DEFINITION: ComPreparationNotification -->
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:3ebb3c44-6710-40c2-8dcd-18349844fa92">
                          <SHORT-NAME>ComPreparationNotification</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This callback function indicates that the signals/signal groups to be sent via a dedicated Com_MainFunctionTx instance will now be prepared for transmission.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">If this parameter is omitted no notification shall take place.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_10020</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
