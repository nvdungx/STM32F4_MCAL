                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: DoIPHostNameSizeMax -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:457138fe-602c-49e1-b1a2-5a0ca1d93822">
                      <SHORT-NAME>DoIPHostNameSizeMax</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maximum Size of the DHCP HostName in ASCII. This parameter is necessary to reserve the correct amount of bytes for working with the DHCP HostName option. Minimum range is 5 because Dhcp Host Name should be at least "DoIP-" on any configuration.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_DoIP_00073</RELATED-TRACE-ITEM-REF>
