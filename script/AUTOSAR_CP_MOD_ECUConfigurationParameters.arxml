                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:9f88b960-971f-838e-6d69-4c4bf18298d1">
                              <SHORT-NAME>DEFAULT_FOR_ECUC_PARTITION</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:af723b6d-0fa5-86df-4a52-aff7ec661094">
                              <SHORT-NAME>ONLY_EXPLICIT_ASSIGNED_CLIENTS</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: SwCluCXccMainTimeBase -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:024edf5f-d40e-41f1-bf20-44dec924719e">
                          <SHORT-NAME>SwCluCXccMainTimeBase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The period between successive calls to according instance of SwCluC_Xcc_MainFunction in seconds. This parameter may be used by the SwCluC generator to transform the given timeout values to internal implementation specific counter or tick values.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00158</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
