                          <REFERENCES>
                            <!-- Choice Symbolic Name Reference Definition: WdgMExternalCheckpointFinalRef -->
                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:aa7d746c-d843-4a93-a671-57ea14c49e92">
                              <SHORT-NAME>WdgMExternalCheckpointFinalRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This is the reference to the final Checkpoint(s) for this External Graph which can end with a WdgMCheckpoint or in case of cross cluster transitions with a WdgMTransitionProxy.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Both WdgMCheckpoint(s) and WdgMTransitionProxy(s) could be mixed inside the same WdgMExternalLogicalSupervision.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_WdgM_00324</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
