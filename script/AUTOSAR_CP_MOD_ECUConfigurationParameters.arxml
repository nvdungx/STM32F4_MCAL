                              <SHORT-NAME>FrNmSynchronizationPointEnabled</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines if this channel shall provide the synchronization point indication to the NM Interface.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrNm_00021</RELATED-TRACE-ITEM-REF>
