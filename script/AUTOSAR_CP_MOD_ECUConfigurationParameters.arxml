                        <!-- Container Definition: J1939NmRxPdu -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:cd6ba114-60e2-4a76-903c-9bd53ad0e9f0">
                          <SHORT-NAME>J1939NmRxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Contains the configuration of the PDU used to receive the AddressClaimed PG. This PDU consumes a meta data item of type CAN_ID_32.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_J1939Nm_00010</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: J1939NmRxPduId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8b5769b0-b023-4312-b133-225e768d24b9">
                              <SHORT-NAME>J1939NmRxPduId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The PDU identifier used for RxIndication from LSduR.</L-2>
                              </DESC>
