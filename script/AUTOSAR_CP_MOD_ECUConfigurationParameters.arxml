            <!-- Module Definition: Dlt -->
            <ECUC-MODULE-DEF UUID="ECUC:d0c40ae6-f4f4-481e-82d7-113da326c396">
              <SHORT-NAME>Dlt</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the Dlt (Log&amp;Trace) module.</L-2>
              </DESC>
              <ADMIN-DATA>
                <DOC-REVISIONS>
                  <DOC-REVISION>
                    <REVISION-LABEL>4.10.0</REVISION-LABEL>
                    <ISSUED-BY>AUTOSAR</ISSUED-BY>
                  </DOC-REVISION>
                </DOC-REVISIONS>
