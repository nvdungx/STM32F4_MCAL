                              <SHORT-NAME>CRYPTO_USE_FNC</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b380c54e-6ae9-8fc2-3abe-062eb7f9ae55">
                              <SHORT-NAME>CRYPTO_USE_PORT</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:bff35287-66e1-9040-30ed-a5b94905cc6d">
                              <SHORT-NAME>CRYPTO_USE_PORT_OPTIMIZED</SHORT-NAME>
