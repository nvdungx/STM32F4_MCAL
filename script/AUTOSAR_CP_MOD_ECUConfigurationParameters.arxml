                            <ECUC-STRING-PARAM-DEF UUID="ECUC:bb6fb5bb-3537-4848-b999-40a466d5ef00">
                              <SHORT-NAME>NmGenericBusNmPrefix</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The prefix which identifies the generic &lt;Bus&gt;Nm. This will be used to determine the API name to be called by Nm for the provided interfaces of the &lt;Bus&gt;Nm. This string will used for the module prefix before the "_" character in the API call name.</L-2>
                              </DESC>
