                            <L-2 L="EN">An error occurred when sending a QSEv via PDU.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00077</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
