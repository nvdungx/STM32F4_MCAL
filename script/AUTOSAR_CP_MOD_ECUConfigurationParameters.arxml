                  <LC-OBJECT-REF DEST="ECUC-DEFINITION-ELEMENT">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMIdsMBlockStateChangeRequest/BswMIdsMBlockStateChangeRequestRef</LC-OBJECT-REF>
                  <LC-STATE-REF DEST="LIFE-CYCLE-STATE">/AUTOSAR/GenDef/LifeCycleStateDefinitionGroups/AutosarLifeCycleStates/draft</LC-STATE-REF>
