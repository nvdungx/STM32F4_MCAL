                            <!-- Choice Reference Definition: SoAdTxSocketConnOrSocketConnBundleRef -->
                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:22ca0917-bfb5-45f5-9765-f859d37d0482">
                              <SHORT-NAME>SoAdTxSocketConnOrSocketConnBundleRef</SHORT-NAME>
