                    <!-- Container Definition: SwCluCDefinition -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0e1a3ae8-88dd-4895-8886-2ec01c7c7af4">
                      <SHORT-NAME>SwCluCDefinition</SHORT-NAME>
