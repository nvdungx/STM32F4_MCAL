                              <DESC>
                                <L-2 L="EN">Defines the type of cross-timestamping between 2 HW clocks in the Ethernet Controller.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00119</RELATED-TRACE-ITEM-REF>
