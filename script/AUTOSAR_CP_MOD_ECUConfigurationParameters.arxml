                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <REFERENCES>
                        <!-- Symbolic Name Reference Definition: SEV_IDSM_COMMUNICATION_ERROR -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:27744824-3d7b-4dee-9fe5-180b4fb5cead">
