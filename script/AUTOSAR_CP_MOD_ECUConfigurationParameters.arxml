                      <SHORT-NAME>SecOCAuthInfoTruncLength</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter defines the length in bits of the authentication code to be included in the payload of the Secured I-PDU.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SecOC_00095</RELATED-TRACE-ITEM-REF>
