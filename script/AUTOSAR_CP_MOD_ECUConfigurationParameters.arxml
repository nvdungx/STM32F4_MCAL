                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                  </PARAMETERS>
                                  <SUB-CONTAINERS>
                                    <!-- Container Definition: V2xDMSimpleTypeBitStringConstr -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:997581c1-7397-40ef-b1b2-a9e0e44988fb">
                                      <SHORT-NAME>V2xDMSimpleTypeBitStringConstr</SHORT-NAME>
                                      <DESC>
