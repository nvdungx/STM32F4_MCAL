                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <REFERENCES>
                        <!-- Reference Definition: WdgMMainFunctionPartitionRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:f57ae74a-f0e6-4ed3-86df-c8cf6ad7a00d">
                          <SHORT-NAME>WdgMMainFunctionPartitionRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to EcucPartition, where the according WdgM_MainFunction instance is assigned to. For the software architecture with single partition, this reference is unnecessary.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
