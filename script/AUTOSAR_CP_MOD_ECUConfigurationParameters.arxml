                      <SUB-CONTAINERS>
                        <!-- Container Definition: J1939RmAckmRxPdu -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c29fc910-2ae7-4d23-b3d6-471a6a664ece">
                          <SHORT-NAME>J1939RmAckmRxPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Contains the configuration of the I-PDU used to receive the Acknowledgement PG. This PDU consumes a meta data item of type CAN_ID_32.</L-2>
                          </DESC>
