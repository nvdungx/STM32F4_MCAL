                    <!-- Symbolic Name Reference Definition: LIN_E_TIMEOUT -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:446e5fcc-d6f0-4bde-ad8f-8cf86f88f501">
                      <SHORT-NAME>LIN_E_TIMEOUT</SHORT-NAME>
                      <DESC>
