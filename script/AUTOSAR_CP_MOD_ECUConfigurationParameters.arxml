                        <!-- Container Definition: SwCluCDemProxyBaseSocket -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:48fc343b-a164-416d-a135-abae1e126c25">
                          <SHORT-NAME>SwCluCDemProxyBaseSocket</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container configures how many EcucPartitions specific API links are required for the Dem Proxy and to which cluster resource the API set belongs.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">In the Dem Low Proxy all offered API sets needs to be configured. In the Dem High Proxy only the ones are configured which are offered inside this Application Software Cluster. The reference SwCluCProxyEcucPartitionRef denotes the EcucPartition on which the API set is provided.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00114</RELATED-TRACE-ITEM-REF>
