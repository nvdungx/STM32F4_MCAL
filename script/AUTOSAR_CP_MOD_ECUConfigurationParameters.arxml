                        <!-- PARAMETER DEFINITION: FrIfMainFunctionPeriod -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:2b9c1311-89e5-40f8-bab5-cc2348c63164">
                          <SHORT-NAME>FrIfMainFunctionPeriod</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The execution cycle of the FrIf_MainFunction_&lt;FrIfCluster.ShortName&gt;() in seconds. The FrIf does not require this information but the BSW scheduler, which invokes the cluster main functions, needs it in order to plan its tasks.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrIf_06003</RELATED-TRACE-ITEM-REF>
