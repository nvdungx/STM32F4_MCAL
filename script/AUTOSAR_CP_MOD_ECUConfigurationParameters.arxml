            <ECUC-MODULE-DEF UUID="ECUC:c59b866e-f4e6-458a-9035-29a85b418af1">
              <SHORT-NAME>LinTrcv</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of LIN Transceiver Driver module</L-2>
              </DESC>
              <ADMIN-DATA>
                <DOC-REVISIONS>
                  <DOC-REVISION>
                    <REVISION-LABEL>4.10.0</REVISION-LABEL>
