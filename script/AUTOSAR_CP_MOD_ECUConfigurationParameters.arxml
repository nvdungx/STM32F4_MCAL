                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d5c19c95-670e-4b7f-a56c-cf2f455409ba">
                          <SHORT-NAME>CanIfRxPduReadNotifyStatus</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables and disables receive indication for each receive CAN L-SDU for reading its notification status.</L-2>
                          </DESC>
