                  <SUB-CONTAINERS>
                    <!-- Container Definition: OsAlarmAction -->
                    <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:2acfb5a0-b476-4fa4-a34c-08e4acfe9858">
