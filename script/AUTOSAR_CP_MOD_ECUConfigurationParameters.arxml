                  <SUB-CONTAINERS>
                    <!-- Container Definition: EthCtrlOffloading -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:44ab9e6d-ad97-4fd3-b26c-b2620681a83b">
                      <SHORT-NAME>EthCtrlOffloading</SHORT-NAME>
