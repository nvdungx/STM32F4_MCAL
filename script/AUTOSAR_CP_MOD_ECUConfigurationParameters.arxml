                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: LinTpRxNSduId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a260e374-b6ba-43eb-97ad-f35f03b2df6c">
                          <SHORT-NAME>LinTpRxNSduId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The identifier of the Transport Protocol message. This ID will be used by upper layers to call LinTp_ChangeParameter.</L-2>
                          </DESC>
