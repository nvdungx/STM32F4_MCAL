                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3bb5ddd0-d50c-94c4-3a4d-0ee9d15ad563">
                                  <SHORT-NAME>SINT32</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4c3fdac6-bcd1-dac4-d4fa-47b66efcd91f">
