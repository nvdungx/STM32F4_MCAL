                      <SHORT-NAME>MkaRetryCyclicDelay</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Interval in seconds between retries after base delay with exponential back off.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mka_00005</RELATED-TRACE-ITEM-REF>
