                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:04149ef6-a503-4ab3-9e64-9b4687747dfb">
                      <SHORT-NAME>UdpNmDynamicPncToChannelMappingSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Precompile time switch to enable the dynamic PNC-to-channel-mapping handling.</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
