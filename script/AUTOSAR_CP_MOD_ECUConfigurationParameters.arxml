                      <MAX>65535</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <!-- Container Definition: DoIPInterface -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:789e2362-020e-4531-b21a-6f65ae92c662">
                      <SHORT-NAME>DoIPInterface</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container defines a logical IP interface and collects properties to configure this interface.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_DoIP_00100</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
