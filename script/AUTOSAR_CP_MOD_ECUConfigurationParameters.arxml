                              <SHORT-NAME>DltLogChannelBufferSize</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Buffer size in bytes for the LogChannel specific message buffer.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00881</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
