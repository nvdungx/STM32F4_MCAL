            <!-- Module Definition: Xfrm -->
            <ECUC-MODULE-DEF UUID="ECUC:0cabde10-00d9-4b21-a0ac-b7f8bd1f2051">
              <SHORT-NAME>Xfrm</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the Xfrm module.</L-2>
              </DESC>
              <ADMIN-DATA>
                <DOC-REVISIONS>
                  <DOC-REVISION>
                    <REVISION-LABEL>4.10.0</REVISION-LABEL>
                    <ISSUED-BY>AUTOSAR</ISSUED-BY>
                  </DOC-REVISION>
                </DOC-REVISIONS>
