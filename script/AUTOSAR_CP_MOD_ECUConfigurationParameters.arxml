                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>4294967295</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: FlsUseInterrupts -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:88a2d255-2439-43a9-888a-c21a750ac380">
                      <SHORT-NAME>FlsUseInterrupts</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Job processing triggered by hardware interrupt.</L-2>
                        <L-2 L="EN">Tags: atp.Status=obsolete</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true: Job processing triggered by interrupt (hardware controlled). false: Job processing not triggered by interrupt (software controlled) or the underlying hardware does not support interrupt mode for flash operations.</L-1>
                        </P>
                        <P>
                          <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Fls_00292</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
