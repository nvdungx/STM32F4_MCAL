                    <!-- PARAMETER DEFINITION: EthIfEnableSecurityEventReporting -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6280c08e-8621-4147-883a-fe8ff023c10c">
                      <SHORT-NAME>EthIfEnableSecurityEventReporting</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the reporting of security events to the IdsM:</L-2>
                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                      </DESC>
                      <INTRODUCTION>
