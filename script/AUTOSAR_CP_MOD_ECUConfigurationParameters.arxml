                        <!-- PARAMETER DEFINITION: CanTSynImmediateTimeSync -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ebca5b87-af6f-48c1-9aa2-e82ad75f4a24">
                          <SHORT-NAME>CanTSynImmediateTimeSync</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables/Disables the cyclic polling of StbM_GetTimeBaseUpdateCounter() within CanTSyn_MainFunction().</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00043</RELATED-TRACE-ITEM-REF>
