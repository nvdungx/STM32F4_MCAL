                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- Reference Definition: DltTraceStatusAssignmentSwcContextRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:44885b9f-0d98-46bd-b668-b61b0169c57f">
                              <SHORT-NAME>DltTraceStatusAssignmentSwcContextRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to an ApplicationId/ContextId pair to which a DltTraceStatus is assigned.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00895</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
