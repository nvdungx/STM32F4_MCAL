                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0f793157-e2c9-4dad-a7d2-1e298f10041f">
                      <SHORT-NAME>UdpNmRemoteSleepIndEnabled</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Pre-processor switch for enabling remote sleep indication support.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">This feature is required for gateway nodes only. It must not be defined if UdpNmPassiveModeEnabled==true. This parameter shall be derived from NmRemoteSleepIndEnabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_UdpNm_00005</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
