                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: DltGeneralRegisterContextNotification -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6384a5ee-f631-45a5-9e97-b2a6be818e14">
                      <SHORT-NAME>DltGeneralRegisterContextNotification</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">If this parameter is set to TRUE, a Dlt Control Message is sent every time a SWC registeres and/or de-registers at/from the Dlt Module. Else, this notification is not sent.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00846</RELATED-TRACE-ITEM-REF>
