                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <!-- Container Definition: LinIfTxPdu -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7640ebc8-a9e9-4673-9ccd-ce63404a29ce">
