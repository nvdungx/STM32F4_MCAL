                      <SHORT-NAME>XcpCounterRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter contains a reference to the counter, which is used by XCP.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Xcp_00162</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
