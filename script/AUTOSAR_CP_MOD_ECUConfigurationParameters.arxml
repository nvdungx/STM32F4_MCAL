                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>255</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: McuRamSectors -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5c7ef78a-cb1b-4ea9-978f-f6c78cd8d738">
                      <SHORT-NAME>McuRamSectors</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter shall represent the number of RAM sectors available for the MCU.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">calculationFormula = Number of configured McuRamSectorSettingConf</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mcu_00172</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
