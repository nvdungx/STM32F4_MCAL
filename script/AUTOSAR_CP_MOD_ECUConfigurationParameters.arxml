                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: LinIfGotoSleepIndicationUL -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:197379df-d73b-425f-bfe1-d8f9e92ba94b">
                          <SHORT-NAME>LinIfGotoSleepIndicationUL</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the upper layer (UL) module to which the indication of the goto-sleep command shall be sent.</L-2>
                          </DESC>
