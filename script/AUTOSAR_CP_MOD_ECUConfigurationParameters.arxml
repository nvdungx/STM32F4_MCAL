                        <!-- Container Definition: DcmDspRequestFileTransfer -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b211345f-c5d7-48cb-8fea-e80915429989">
                          <SHORT-NAME>DcmDspRequestFileTransfer</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the configuration for RequestFileTransfer.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This container only exists if RequestFileTransfer is configured.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01034</RELATED-TRACE-ITEM-REF>
