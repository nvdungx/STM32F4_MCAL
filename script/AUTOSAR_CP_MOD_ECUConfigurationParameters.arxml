                        <!-- PARAMETER DEFINITION: DoIPInterfaceActLineCtrl -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6e2237e3-5bac-41e9-bf4a-ae8559979fa6">
                          <SHORT-NAME>DoIPInterfaceActLineCtrl</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This attribute defines whether the network interface</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">* is started "on-demand" when an activation line is sensed (TRUE) or * is always available (FALSE).</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_DoIP_00101</RELATED-TRACE-ITEM-REF>
