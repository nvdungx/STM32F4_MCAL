                <!-- Container Definition: DltSwc -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3b15a4e2-01f9-43e0-b41a-8212eb14407a">
                  <SHORT-NAME>DltSwc</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Contains necessary configuration parameters of the AUTOSAR Dlt module to interact with SWCs.</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00856</RELATED-TRACE-ITEM-REF>
