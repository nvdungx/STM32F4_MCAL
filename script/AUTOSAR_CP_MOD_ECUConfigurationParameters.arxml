                  <LC-OBJECT-REF DEST="ECUC-DEFINITION-ELEMENT">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMIdsMBlockStateChangeRequest</LC-OBJECT-REF>
