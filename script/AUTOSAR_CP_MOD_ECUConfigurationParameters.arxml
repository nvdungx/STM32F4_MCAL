                        <!-- PARAMETER DEFINITION: DoIPUseMacAddressForIdentification -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:364c701f-a202-4a4b-b7bc-ee6cf58cddb3">
                          <SHORT-NAME>DoIPUseMacAddressForIdentification</SHORT-NAME>
