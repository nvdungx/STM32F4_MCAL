                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: LinIfFramePriority -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:52c7ca27-7e7c-41f9-8a29-9660a446d4f7">
                                  <SHORT-NAME>LinIfFramePriority</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Priority of sporadic frame in a master node or of event-triggered frame in slave node.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinIf_00513</RELATED-TRACE-ITEM-REF>
