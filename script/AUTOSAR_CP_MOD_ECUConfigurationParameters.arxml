                        <L-2 L="EN">Pre-processor switch for enabling support of the Passive Mode.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_UdpNm_00010</RELATED-TRACE-ITEM-REF>
