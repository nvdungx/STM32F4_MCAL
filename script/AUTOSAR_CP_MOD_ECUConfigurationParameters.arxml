                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: RamTstDefaultAlgParamsId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:06024431-c473-4eca-9fc7-cb09b2c469a0">
                          <SHORT-NAME>RamTstDefaultAlgParamsId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This is the identifier for the default "RamTstAlgParams" valid after the "RamTst_Init(..)" function. It is the initial value for a RAM variable which could be changed by the function "RamTst_SelectAlgParams".</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_RamTst_00181</RELATED-TRACE-ITEM-REF>
