                  <SUB-CONTAINERS>
                    <!-- Container Definition: PduRBuffer -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:49403503-38ea-4903-a735-464e90ac37c3">
                      <SHORT-NAME>PduRBuffer</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies a buffer used for gatewaying via communication interfaces or transport protocols, transport protocol 1:n receiving, or for fan-in reception routing for communication interface modules.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_PduR_00336</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
