                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: DltTraceStatus -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e8ad8ffc-d6e7-4811-85db-09ed1a1b5758">
                              <SHORT-NAME>DltTraceStatus</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Trace status for the given ApplicationId/ContextId tuple.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00874</RELATED-TRACE-ITEM-REF>
