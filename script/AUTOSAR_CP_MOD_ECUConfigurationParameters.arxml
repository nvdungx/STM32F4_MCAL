                        <!-- Foreign Reference Definition: ComSystemTemplateSystemSignalRef -->
                        <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:c5ba8319-d7d4-97bc-3e3e-f33ac5481dc0">
                          <SHORT-NAME>ComSystemTemplateSystemSignalRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to the ISignalToIPduMapping that contains a reference to the ISignal (System Template) which this ComSignal (or ComGroupSignal) represents.</L-2>
