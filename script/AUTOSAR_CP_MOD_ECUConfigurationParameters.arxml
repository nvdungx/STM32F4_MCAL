                          <MAX INTERVAL-TYPE="CLOSED">1</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.05</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: LinTpScheduleChangeDiag -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a4f81595-1b5d-411a-b67c-12813b6e908e">
                          <SHORT-NAME>LinTpScheduleChangeDiag</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables or disables the call of BswM_LinTp_RequestMode() to diagnostic request/response schedule.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">false: BswM is not called true: BswM is called Only used for LIN Master nodes, ignored for slave nodes.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinTp_00070</RELATED-TRACE-ITEM-REF>
