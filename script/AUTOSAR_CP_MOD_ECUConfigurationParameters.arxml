                              <SHORT-NAME>IdsMNthParameter</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">For each SEv ID for which this filter is configured, this parameter assigns the appropriate n.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Only 1 from n SEvs will be forwarded.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00023</RELATED-TRACE-ITEM-REF>
