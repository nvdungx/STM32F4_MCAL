                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: CanIfTxPduTruncation -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f99fc5ef-40ed-4b76-bc9e-db3486b56f34">
                          <SHORT-NAME>CanIfTxPduTruncation</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables/disables truncation of PDUs that exceed the configured size.</L-2>
                          </DESC>
