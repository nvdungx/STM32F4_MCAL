                                <L-2 L="EN">Specifies the cycle time in seconds for resetting the buffer overflow flag in case a buffer overflow occurred.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00886</RELATED-TRACE-ITEM-REF>
