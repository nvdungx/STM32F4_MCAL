                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: SwCluCXccClientAssignment -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:39db72a2-6336-4762-8c0f-c042244a898d">
                          <SHORT-NAME>SwCluCXccClientAssignment</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines if the SwCluC_Xcc_MainFunction is used as default main function for all clients which are not referenced explicitly by a SwCluCXccClientInstanceRef on this EcucPartition</L-2>
                          </DESC>
