                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: IdsMForwardEveryNthFilter -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:695c19c9-276c-45a0-9ba2-d3d6d4ed8c9d">
                          <SHORT-NAME>IdsMForwardEveryNthFilter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Out of all incoming SEVs, drop all but every nth. Those will be forwarded without modification.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00022</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
