                            <!-- Choice Reference Definition: DcmSwcSRDataElementRef -->
                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:ee92360f-60c0-42b1-b31b-4ff5dfc700c0">
                              <SHORT-NAME>DcmSwcSRDataElementRef</SHORT-NAME>
                              <DESC>
