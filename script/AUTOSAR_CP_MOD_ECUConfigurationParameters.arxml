                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: CsmJobId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4b81b3b5-a0f6-456c-b111-4dfafd8f4b88">
                          <SHORT-NAME>CsmJobId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Identifier of the CSM job. The set of actually configured identifiers shall be consecutive and gapless.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Csm_00119</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
