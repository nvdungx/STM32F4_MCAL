                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: EthCtrlPulsePerSecondConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1cbc1141-319a-4e62-9ffa-3cfb7b594982">
                          <SHORT-NAME>EthCtrlPulsePerSecondConfig</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the configuration of a HW Pulse per Second (PPS) feature. If not defined the PPS feature is not used.</L-2>
