                      <SUB-CONTAINERS>
                        <!-- Container Definition: J1939TpRxCmNPdu -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6684e309-b1d7-4cbf-993b-59dfa69448a6">
                          <SHORT-NAME>J1939TpRxCmNPdu</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This N-PDU represents the TP.CM frame of a J1939 transport protocol session. TP.CM is used both by BAM and CMDT to initialize the connection. For CMDT, it is also used to abort the connection. This N-PDU consumes a meta data item of type CAN_ID_32.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_J1939Tp_00128</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
