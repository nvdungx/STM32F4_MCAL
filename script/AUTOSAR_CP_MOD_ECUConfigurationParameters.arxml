                      <SHORT-NAME>DemFreezeFrameClass</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the combinations of DIDs for freeze frames of UDS and emission related diagnostics over UDS.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00673</RELATED-TRACE-ITEM-REF>
