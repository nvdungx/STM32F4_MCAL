                    <!-- PARAMETER DEFINITION: DltProtocolVersion -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3b433c7f-d600-4b5c-91a7-16c8e94cdae7">
                      <SHORT-NAME>DltProtocolVersion</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Selects the DLT protocol version to be used by Dlt module. Currently the versions 1 and 2 are supported.</L-2>
                      </DESC>
