                    <!-- PARAMETER DEFINITION: DltGeneralStartUpDelayTimer -->
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4deadb4c-99e1-4ef4-8ee8-996ce1672815">
                      <SHORT-NAME>DltGeneralStartUpDelayTimer</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configurable delay in s of starting the transmission of Log and Trace messages after the Dlt module has been initialized.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00897</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
