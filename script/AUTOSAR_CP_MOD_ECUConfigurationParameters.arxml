                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition</DESTINATION-REF>
                    </ECUC-REFERENCE-DEF>
                    <!-- Reference Definition: OcuKernelEcucPartitionRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:a25d816c-e8fc-43cf-a0c8-d060b93164bf">
                      <SHORT-NAME>OcuKernelEcucPartitionRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maps the OCU kernel to zero or one ECUC partitions to assign the driver kernel to a certain core. The ECUC partition referenced is a subset of the ECUC partitions where the OCU driver is mapped to.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Ocu_00168</RELATED-TRACE-ITEM-REF>
