                                  <SHORT-NAME>LinIfDelay</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Delay to next entry in schedule table in seconds.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinIf_00009</RELATED-TRACE-ITEM-REF>
