                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-STRING-PARAM-DEF-VARIANTS>
                            <ECUC-STRING-PARAM-DEF-CONDITIONAL></ECUC-STRING-PARAM-DEF-CONDITIONAL>
                          </ECUC-STRING-PARAM-DEF-VARIANTS>
                        </ECUC-STRING-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: ComMChannelId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cb043376-bcae-41fa-991d-de06f78c3aaf">
                          <SHORT-NAME>ComMChannelId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Channel identification number of the corresponding channel.</L-2>
                          </DESC>
