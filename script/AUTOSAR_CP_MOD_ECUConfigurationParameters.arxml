                        <!-- PARAMETER DEFINITION: FrNmVotingNextToLastRepetitionCycleDisable -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:37b00527-fec3-43ff-92c6-07b2439173d3">
                          <SHORT-NAME>FrNmVotingNextToLastRepetitionCycleDisable</SHORT-NAME>
