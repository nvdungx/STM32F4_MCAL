                    <!-- PARAMETER DEFINITION: DltGeneralTimeStampSupport -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e02dd21c-bc38-4b38-990d-e35be1a43ddd">
                      <SHORT-NAME>DltGeneralTimeStampSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">If a Time Stamp shall be added to the Dlt messages, this configuration parameter shall be set to TRUE.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Otherwise, it shall be set to FALSE.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00850</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
