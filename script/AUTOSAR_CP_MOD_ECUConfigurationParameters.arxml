                    <!-- PARAMETER DEFINITION: StbMQueryFreshnessValue -->
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:7481a446-0193-4163-8e3e-749cb71c67bb">
                      <SHORT-NAME>StbMQueryFreshnessValue</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter specifies if the freshness value shall be determined through a C-function (CD) or a software component (SW-C).</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_StbM_00076</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
