                <!-- Container Definition: SwCluCBaseConfigurationCheck -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c768287c-7e93-4f25-887a-fb389e3219e4">
                  <SHORT-NAME>SwCluCBaseConfigurationCheck</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Configuration of the base configuration check of Software Cluster Connection.</L-2>
                  </DESC>
                  <INTRODUCTION>
                    <P>
                      <L-1 L="EN">This configuration places a mandatory entry in the Binary Manifest where the guard value is used to proof if the general setup of the Application Software Cluster is compatible to the general setup of the Host Software Cluster. For each Application Software Cluster an individual base configuration check should be defined.</L-1>
                    </P>
                  </INTRODUCTION>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00079</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                  <MULTIPLICITY-CONFIG-CLASSES>
                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  </MULTIPLICITY-CONFIG-CLASSES>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <PARAMETERS>
                    <!-- PARAMETER DEFINITION: SwCluCAutoBaseConfigDescriptor -->
                    <ECUC-MULTILINE-STRING-PARAM-DEF UUID="ECUC:64fb4971-410a-4574-ba7b-e75d1bf678b2">
                      <SHORT-NAME>SwCluCAutoBaseConfigDescriptor</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">A machine determined string which represent the basic configuration assumption.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Multiple SwCluCAutoBaseConfigDescriptor values can be added to support that different tools contribute to the checksum. For instance Software Cluster Connection Tool, Compiler, Link, or Locate tooling. isAuto shall be set to true since tool chain adds its collected values automatically.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00080</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <SCOPE>ECU</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
