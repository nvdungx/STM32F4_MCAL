                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">10</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.05</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: LinTpP2Timing -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:7224db3b-049b-4739-a1de-40d00a6c61c5">
                          <SHORT-NAME>LinTpP2Timing</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Definition of the P2max timeout observation parameter in seconds.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Only used for LIN Master nodes, ignored for slave nodes.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinTp_00625</RELATED-TRACE-ITEM-REF>
