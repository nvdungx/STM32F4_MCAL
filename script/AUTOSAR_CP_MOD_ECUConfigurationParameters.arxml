                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c6a41e40-cf16-4c3d-8296-9b1750ca2aae">
                          <SHORT-NAME>EthIfSwitchPortGroupRefSemantics</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines how the EthIfSwitchRefOrPortGroupRef refering to a EthIfSwitchPortGroup shall be interpreted.</L-2>
                          </DESC>
