                      <SUB-CONTAINERS>
                        <!-- Container Definition: FrTSynGlobalTimeRxIcvVerification -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c6f36d32-d337-417c-9fc4-3fc2310ea366">
                          <SHORT-NAME>FrTSynGlobalTimeRxIcvVerification</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container collects configuration required for ICV verification.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrTSyn_00056</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
