                      <SHORT-NAME>CanTSynEnableTimeValidation</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables/disables time recording for Time Validation for a specific Time Domain.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTSyn_00051</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
