                      <SUB-CONTAINERS>
                        <!-- Container Definition: SwCluCLdComProxyBaseSocket -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ec7ab420-24e1-442f-9890-0bfb3782c976">
                          <SHORT-NAME>SwCluCLdComProxyBaseSocket</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container configures how many EcucPartitions specific API links are required for the LdCom Proxy and to which cluster resource the API set belongs.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">In the LdCom Low Proxy all offered API sets (incl. callbacks) needs to be configured. In the LdCom High Proxy only the ones are configured which are offered inside this Application Software Cluster. The reference SwCluCProxyEcucPartitionRef denotes the EcucPartition on which the API set is provided. The LdComUserModuleCnf is only applicable in the Host Software Cluster and shall not be configured in the scope of a Application Software Cluster. One LdComUserModuleCnf instance can either server for LdComIPdus on multiple EcucPartitons or exactly one EcucPartiton. How many LdComUser instances an Rte in an related Application Software Cluster requires is vendor specific.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00129</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: SwCluCNativeBswApi -->
