                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <MAX>127</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: DcmDsdSubServiceUsed -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:4c3b0201-958c-4428-800e-39b28447f982">
                                      <SHORT-NAME>DcmDsdSubServiceUsed</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Allows to activate or deactivate the usage of a Subservice. This parameter can be used for multi-purpose ECUs.</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">true - subservice is available false - subservice is not available.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01047</RELATED-TRACE-ITEM-REF>
