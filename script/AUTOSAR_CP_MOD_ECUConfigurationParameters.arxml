                      <SHORT-NAME>DoIPVinInvalidityPattern</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the Byte pattern that is used for response messages if no valid VIN could be retrieved.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Only the value '0' or '255' is allowed".</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_DoIP_00066</RELATED-TRACE-ITEM-REF>
