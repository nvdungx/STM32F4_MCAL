                              <MAX>65535</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: RamTstNumberOfTestedCells -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8ba7b460-0266-4e5f-816d-0d5aa100dfa7">
                              <SHORT-NAME>RamTstNumberOfTestedCells</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This is the initial value for a RAM variable, which can be changed by the function "RamTst_ChangeNumberOfTestedCells"</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_RamTst_00142</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
