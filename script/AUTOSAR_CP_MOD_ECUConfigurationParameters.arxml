                      </DESTINATION-REFS>
                    </ECUC-CHOICE-REFERENCE-DEF>
                    <!-- Reference Definition: NvMEcucPartitionRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:d779b2c3-4ab6-411c-9fa9-7d00f154e265">
                      <SHORT-NAME>NvMEcucPartitionRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maps the NvM to one or multiple ECUC partitions to make its C-APIs available in the according partition.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00565</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
