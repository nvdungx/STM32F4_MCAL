                        <!-- PARAMETER DEFINITION: ComUpdateBitPosition -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3d27527d-d679-8d0a-5537-d1ca2ba3ee67">
                          <SHORT-NAME>ComUpdateBitPosition</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Bit position of update-bit inside I-PDU.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">If this attribute is omitted then there is no update-bit. This setting must be consistently on sender and on receiver side. Range: 0..63 for CAN and LIN, 0..511 for CAN FD, 0..2031 for FlexRay, 0..4294967295 for TP.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00257</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
