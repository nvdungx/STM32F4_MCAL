                        </ECUC-REFERENCE-DEF>
                        <!-- Symbolic Name Reference Definition: SEV_IDSM_NO_CONTEXT_DATA_BUFFER_AVAILABLE -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:951a1f5a-d65d-4560-850d-5e5d150ba7a7">
                          <SHORT-NAME>SEV_IDSM_NO_CONTEXT_DATA_BUFFER_AVAILABLE</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The context data of an incoming event cannot be stored because there are no more context data buffers available.</L-2>
