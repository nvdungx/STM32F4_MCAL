                    <!-- PARAMETER DEFINITION: ComMDirectUserMapping -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a4afa581-00d4-4e58-bcc3-4b9290cacd24">
                      <SHORT-NAME>ComMDirectUserMapping</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">If this parameter is set to true the configuration tool shall automatically create a ComMUser per ComMPnc and a ComMUser per ComMChannel.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">The shortName of the generated ComMUsers shall follow the following naming convention: PNCUser_ComMPncId, e.g. PNCUser_13 ChannelUser_ComMChannelId, e.g. ChannelUser_25 Restriction: ComMUser, which are created due to this configuration parameter, shall not be used by SWCs (only available for BswM).</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_ComM_00840</RELATED-TRACE-ITEM-REF>
