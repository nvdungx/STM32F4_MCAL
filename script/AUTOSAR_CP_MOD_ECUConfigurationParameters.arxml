                                <ECUC-REFERENCE-DEF UUID="ECUC:a6fbc267-d93c-49b9-87fb-672ddc7d41a1">
                                  <SHORT-NAME>FrNmTxPduRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">The reference to a PDU in the global PDU structure described in the AUTOSAR ECU Configuration Specification. This reference is used to derive the PDU Id that is defined by the LSduR module.</L-2>
                                  </DESC>
