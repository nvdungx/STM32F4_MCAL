                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:21645185-ede2-413f-a98d-d2d27b5439f9">
                          <SHORT-NAME>CanNmMsgCycleTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Period of a NM PDU in seconds. It determines the periodic rate in the "periodic transmission mode with bus load reduction" and is the basis for transmit scheduling in the "periodic transmission mode without bus load reduction".</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00028</RELATED-TRACE-ITEM-REF>
