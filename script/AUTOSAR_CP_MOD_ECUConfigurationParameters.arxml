                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- Reference Definition: EthClkUnitTimePhcRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:65ee4bdb-bb3f-4e62-86de-37c52fb993f2">
                              <SHORT-NAME>EthClkUnitTimePhcRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to a HW clock in the Ethernet controller, which can be configured as PTP hardware clock (PHC).</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00117</RELATED-TRACE-ITEM-REF>
