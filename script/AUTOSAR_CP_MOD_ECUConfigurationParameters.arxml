                        <!-- Container Definition: J1939DcmModeRule -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e149b9df-74e7-423b-b42b-0c9700e08272">
                          <SHORT-NAME>J1939DcmModeRule</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the configuration of a mode rule which represents a logical expression with J1939DcmModeConditions or other J1939DcmModeRules as arguments.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">All arguments are processed with the operator defined by DcmLogicalOperator, for instance: Argument_A AND Argument_B AND Argument_C</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_J1939Dcm_00053</RELATED-TRACE-ITEM-REF>
