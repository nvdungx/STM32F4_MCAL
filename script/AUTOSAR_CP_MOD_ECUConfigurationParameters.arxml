                    <!-- PARAMETER DEFINITION: FlsAcLoadOnJobStart -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:622bd1f2-a9e0-4043-9b1a-8baa38771911">
                      <SHORT-NAME>FlsAcLoadOnJobStart</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The flash driver shall load the flash access code to RAM whenever an erase or write job is started and unload (overwrite) it after that job has been finished or canceled.</L-2>
                        <L-2 L="EN">Tags: atp.Status=obsolete</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true: Flash access code loaded on job start / unloaded on job end or error. false: Flash access code not loaded to / unloaded from RAM at all.</L-1>
                        </P>
                        <P>
                          <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Fls_00284</RELATED-TRACE-ITEM-REF>
