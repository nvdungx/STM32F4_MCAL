                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: FiMCallbackFIDStatusChangedFnc -->
                            <ECUC-FUNCTION-NAME-DEF UUID="ECUC:667e319d-c2b0-4f92-b51a-0c4dfdeaf02e">
                              <SHORT-NAME>FiMCallbackFIDStatusChangedFnc</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">If this parameter is configured, it defines the c callout function name that is called when the FID state changes. If this parameter is not configured, the operation CBFidStatusChanged on the C/S interface FiM_FunctionInhibition is called.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FiM_00614</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
