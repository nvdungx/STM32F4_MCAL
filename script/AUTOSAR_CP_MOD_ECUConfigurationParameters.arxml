                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: ComInitialValueOnly -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:30b91895-a01b-8d42-43b4-175f69097d09">
                          <SHORT-NAME>ComInitialValueOnly</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines that the respective signal's initial value shall be put into the respective PDU but there will not be any update of the value through the users (e.g. RTE, SwCluC). Thus the Com implementation does not need to expect any API calls for this signal (group).</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00811</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
