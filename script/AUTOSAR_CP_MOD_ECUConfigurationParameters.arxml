                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <!-- Container Definition: LinIfEntry -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5856d22c-f08e-4597-aa05-a2fa836b7ec8">
                              <SHORT-NAME>LinIfEntry</SHORT-NAME>
