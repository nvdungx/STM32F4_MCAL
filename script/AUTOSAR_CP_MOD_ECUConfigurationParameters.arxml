                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspDid/DcmDspDidSupportInfo</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: DcmDspExternalSRDataElementClass -->
                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:4e6bffd4-147c-40f0-8f09-f31265103b92">
                              <SHORT-NAME>DcmDspExternalSRDataElementClass</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container defines the source of data in a provided port which shall be read respectively the target of data in a required port which shall be written.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container shall contain either one DcmSubElementInDataElementInstance OR DcmDataElementInstance OR DcmSubElementInImplDataElementInstance reference.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00989</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <CHOICES>
                                <!-- Container Definition: DcmDataElementInstance -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f74d3dfd-fa56-8a71-4417-c205b4bb79cf">
                                  <SHORT-NAME>DcmDataElementInstance</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Instance Reference to the primitive data in a port where the data element is typed with an ApplicationPrimitveDataType or an ImplementationDataType.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01010</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <REFERENCES>
                                    <!-- Instance Reference Definition: DcmDataElementInstanceRef -->
                                    <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:3c44b82a-cdcf-d321-d6d3-46e41e8aff43">
                                      <SHORT-NAME>DcmDataElementInstanceRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Instance Reference to the primitive or array data which shall be read or written.</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Supported are VariableDataPrototypes in SenderReceiverInterfaces and NvDataInterfaces and ParameterDataPrototypes in ParameterInterfaces (read only). This reference is applicable if the AutosarDataPrototype is typed with a ApplicationPrimitiveDataType of category VALUE or BOOLEAN or ApplicationArrayDataType or if the AutosarDataPrototype is typed with a ImplementationDataType of category VALUE, ARRAY or TYPE_REFERENCE that in turn boils down to VALUE or ARRAY</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00991</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-CONTEXT>ROOT-SW-COMPOSITION-PROTOTYPE SW-COMPONENT-PROTOTYPE PORT-PROTOTYPE</DESTINATION-CONTEXT>
                                      <DESTINATION-TYPE>AUTOSAR-DATA-PROTOTYPE</DESTINATION-TYPE>
                                    </ECUC-INSTANCE-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <!-- Container Definition: DcmSubElementInDataElementInstance -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4d6a510b-073a-8d83-18f6-1601847108cd">
                                  <SHORT-NAME>DcmSubElementInDataElementInstance</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port where the data element is typed with an ApplicationCompositeDataType.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01009</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <REFERENCES>
                                    <!-- Instance Reference Definition: DcmSubElementInDataElementInstanceRef -->
                                    <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:92cb4f89-788c-dac7-d44a-9ebaae808c40">
                                      <SHORT-NAME>DcmSubElementInDataElementInstanceRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port which shall be read.</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Supported are VariableDataPrototypes in SenderReceiverInterfaces and NvDataInterfaces and ParameterDataPrototypes in ParameterInterfaces (read only). This reference is applicable if the AutosarDataPrototype is typed with a ApplicationCompositeDataType.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00990</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
