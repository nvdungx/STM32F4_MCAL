                              </REFERENCES>
                              <SUB-CONTAINERS>
                                <!-- Container Definition: DcmDslConnection -->
                                <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:b4b72325-5ba3-4f11-a666-cb8899c92aec">
                                  <SHORT-NAME>DcmDslConnection</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container contains the configuration of a communication channel for one particular protocol.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Note that it is allowed to communicate with multiple testers, therefore multiple connections may be configured for a protocol.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00705</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <CHOICES>
                                    <!-- Container Definition: DcmDslMainConnection -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:787d42ea-80c4-421b-b78a-15d1815c5b9e">
                                      <SHORT-NAME>DcmDslMainConnection</SHORT-NAME>
                                      <DESC>
