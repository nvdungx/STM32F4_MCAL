                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: SwCluCNvMProxy -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5daebe07-a9e7-43a3-a27d-f5c28a3b9b5c">
                      <SHORT-NAME>SwCluCNvMProxy</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">NvM Proxy specific parameters.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00039</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
