                                      <SHORT-NAME>LinIfRxPduRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Reference to the PDU that is received in this frame.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinIf_00036</RELATED-TRACE-ITEM-REF>
