                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: PduRTpRxIndication -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:303cbc97-1783-4b30-bcda-64218daaa0d6">
                      <SHORT-NAME>PduRTpRxIndication</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies if the Transport protocol module supports the TpRxIndication API or not. Value true the API is supported.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_PduR_00364</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
