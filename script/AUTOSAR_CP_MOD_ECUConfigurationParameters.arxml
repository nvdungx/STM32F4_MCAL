                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <!-- Container Definition: IpduMContainedRxPdu -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:23135174-a437-419a-9d97-d0c8a6da224d">
                      <SHORT-NAME>IpduMContainedRxPdu</SHORT-NAME>
                      <DESC>
