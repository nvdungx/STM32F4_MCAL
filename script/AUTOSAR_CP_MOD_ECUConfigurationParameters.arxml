                        </ECUC-BOOLEAN-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: CanIfTxPduReadNotifyStatus -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:019d12d4-5a3d-44df-a3a4-467cf0674e1b">
                          <SHORT-NAME>CanIfTxPduReadNotifyStatus</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables and disables transmit confirmation for each transmit CAN L-SDU for reading its notification status.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">True: Enabled False: Disabled</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanIf_00589</RELATED-TRACE-ITEM-REF>
