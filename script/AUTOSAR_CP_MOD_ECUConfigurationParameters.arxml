                                        <!-- PARAMETER DEFINITION: EthSwtETSConfigAvailableBandwidthInWeightValue -->
                                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f5304750-2bdd-4e40-9511-7d031ab6854e">
