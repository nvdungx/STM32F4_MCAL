                    <!-- Reference Definition: V2xDMEcucPartitionRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:8f8b8d5a-8a19-411d-8cbd-d9cff7d5c15d">
                      <SHORT-NAME>V2xDMEcucPartitionRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to EcucPartition, where V2x Data Manager module is assigned to.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_V2xDM_00098</RELATED-TRACE-ITEM-REF>
