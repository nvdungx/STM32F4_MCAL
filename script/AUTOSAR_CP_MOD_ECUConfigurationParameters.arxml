                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <PARAMETERS>
                    <!-- PARAMETER DEFINITION: DoIPGid -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6ae455ce-c20e-4a97-b23a-c2bbb93fecea">
                      <SHORT-NAME>DoIPGid</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configured GID (Group ID of) for vehicle identification/vehicle announcement.</L-2>
                      </DESC>
