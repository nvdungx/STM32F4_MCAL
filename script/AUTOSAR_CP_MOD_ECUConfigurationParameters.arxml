                                <ECUC-REFERENCE-DEF UUID="ECUC:805d3919-9dfb-4b43-9ae1-6960d5e38e48">
                                  <SHORT-NAME>DcmDslProtocolTxBufferRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to a configured diagnostic buffer that is used for diagnostic response transmission for the protocol.</L-2>
                                  </DESC>
