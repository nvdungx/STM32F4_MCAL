                    <!-- PARAMETER DEFINITION: MaxSwcLogMessageLength -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7a1e89ab-bb12-4156-8224-ac730535c68b">
                      <SHORT-NAME>MaxSwcLogMessageLength</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the maximum allowed length (uint16) for LogMessages.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">The upper limit for the range of this parameter is currently defined by the range of the data type. The actual upper limit for the range of this parameter is identical to the maximum length of all configured Dlt log or trace messages, which is known when all log or trace messages are configured.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dlt_00909</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
