                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:98adeee2-ae9a-d1c0-ddf6-995b8f8fa6c6">
                              <SHORT-NAME>PENDING</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4195a29a-ed82-db12-c74b-fbbdbbb6d2b6">
                              <SHORT-NAME>TRIGGERED</SHORT-NAME>
