                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9f75e132-b72b-48c7-98cd-0e9a197850a1">
                              <SHORT-NAME>TcpIpProtocol</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Relevant IP protocol.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Note: As specified in IETF Rfc 4301 section 6, ICMP error messages will always be BYPASSed. The policy for TCPIP_PROTOCOL_ICMP only applies to ICMP non-error messages. (Echo reply/response).</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00306</RELATED-TRACE-ITEM-REF>
