                            <!-- PARAMETER DEFINITION: J1939RmAckmRxPduId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:384018fd-c035-4758-b3ce-3588af856fe3">
                              <SHORT-NAME>J1939RmAckmRxPduId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The I-PDU identifier used for RxIndication from PduR.</L-2>
                              </DESC>
