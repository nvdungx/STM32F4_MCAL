                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:37fe990f-a98e-d4e1-ba6c-3024f09ccbe3">
                                  <SHORT-NAME>UINT16_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:759dabd4-de6e-8b4c-43c0-12284dd85580">
                                  <SHORT-NAME>UINT32</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4bf203fe-832f-d85b-a20e-f5f99212f36e">
                                  <SHORT-NAME>UINT32_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:501a19d1-a5a2-8c78-3a3f-99a4c2d7440d">
                                  <SHORT-NAME>UINT8</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
