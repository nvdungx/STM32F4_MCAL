            <!-- Module Definition: LinTp -->
            <ECUC-MODULE-DEF UUID="ECUC:6f8dbcae-995f-4506-b84b-0be0f7a3fdc8">
              <SHORT-NAME>LinTp</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the LIN Transport Protocol.</L-2>
              </DESC>
              <ADMIN-DATA>
