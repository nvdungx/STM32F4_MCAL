                          <REFERENCES>
                            <!-- Choice Reference Definition: SwCluCDcmProxyDataRef -->
                            <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:544a38d1-092c-4252-87ff-6c387eb021eb">
                              <SHORT-NAME>SwCluCDcmProxyDataRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the diagnostic data of Dcm which can either be a DcmDspData, or a DcmDspPidService01, or a DcmDspDid.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">The DcmDspDid reference is only applicable in the Application Software Cluster if the DID has exactly one Diagnostic Data Element requiring the DID based interface. The reference is mandatory in the Application Software Cluster and can be used in the Host Software Cluster to identify the related diagnostic data in the Dcm configuration.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00123</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <DESTINATION-REFS>
                                <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspData</DESTINATION-REF>
                                <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspDid</DESTINATION-REF>
                                <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspPid/DcmDspPidData/DcmDspPidService01</DESTINATION-REF>
                                <DESTINATION-REF DEST="ECUC-CHOICE-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dem/DemGeneral/DemDataElementClass</DESTINATION-REF>
                              </DESTINATION-REFS>
                            </ECUC-CHOICE-REFERENCE-DEF>
                            <!-- Foreign Reference Definition: SwCluCDextDiagnosticDataElementRef -->
                            <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:48d36e3a-aef3-424f-8cd9-eb91712a0b45">
                              <SHORT-NAME>SwCluCDextDiagnosticDataElementRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the DiagnosticDataElement in DEXT for back-tracing in case of DEXT based configuration approaches</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00138</RELATED-TRACE-ITEM-REF>
