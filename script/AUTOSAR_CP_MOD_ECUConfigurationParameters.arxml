                    </ECUC-INTEGER-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: DoIPLogicalAddress -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:de58f8a2-7680-4522-bae5-18d4b0444ed9">
                      <SHORT-NAME>DoIPLogicalAddress</SHORT-NAME>
