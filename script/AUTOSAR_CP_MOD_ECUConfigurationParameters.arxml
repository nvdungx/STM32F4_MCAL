                                    <L-2 L="EN">Policy regarding destruction or non-destruction of memory content.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_RamTst_00177</RELATED-TRACE-ITEM-REF>
