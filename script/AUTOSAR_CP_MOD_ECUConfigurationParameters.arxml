                  </PARAMETERS>
                  <REFERENCES>
                    <!-- Reference Definition: EthEcucPartitionRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:ec2e160d-fd07-47d6-9f75-55489128a338">
                      <SHORT-NAME>EthEcucPartitionRef</SHORT-NAME>
