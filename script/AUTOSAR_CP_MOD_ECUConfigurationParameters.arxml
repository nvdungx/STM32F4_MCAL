                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: SwCluCOsProxyMaxNumberOfCallee -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7301a365-c4e6-4b21-84b2-151b3a34189d">
                                  <SHORT-NAME>SwCluCOsProxyMaxNumberOfCallee</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines how many Dispatch Entry Points the dispatcher of the Os Low Proxy is able to call at most.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">In the Os Low Proxy this configuration parameter is mandatory.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00062</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>ECU</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SwCluCOsProxyMinimumStartInterval -->
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:29684472-eeec-421a-8975-f2af382125c0">
                                  <SHORT-NAME>SwCluCOsProxyMinimumStartInterval</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the time in seconds by which two consecutive starts of an dispatcher Runnable are guaranteed to be separated.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00070</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>ECU</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">INF</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <!-- Reference Definition: SwCluCOsProxyEcucPartitionRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:c0b63d11-33b1-4515-b57a-5173fd85b4db">
                                  <SHORT-NAME>SwCluCOsProxyEcucPartitionRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">If the reference is not provided, the task dispatcher is provided on the EcuPartition to which the OsApplication of the OsTask related to the owning SwCluCOsProxyOsTask belongs.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">If the reference is provided, the task dispatcher is provided on the referenced EcuPartition. In this case the task dispatcher is scheduled in the OsTask related to the owning SwCluCOsProxyOsTask but is changing its partition before the task dispatcher schedules proxy tasks in the Application Software Cluster.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00078</RELATED-TRACE-ITEM-REF>
