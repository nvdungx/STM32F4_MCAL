                            <!-- Reference Definition: EthClkUnitTimeStampingRef -->
                            <ECUC-REFERENCE-DEF UUID="ECUC:26158a76-cca3-4ffd-b3e9-6092bf81d7b2">
                              <SHORT-NAME>EthClkUnitTimeStampingRef</SHORT-NAME>
                              <DESC>
