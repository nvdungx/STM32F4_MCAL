                  <REFERENCES>
                    <!-- Reference Definition: DoIPUseEidAsGidRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:c74b3af7-5714-4371-bac9-4c639fdf0af1">
                      <SHORT-NAME>DoIPUseEidAsGidRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to the interface containing the EID which shall be used as GID. Depending on the configuration, the GID is derived either from DoIPEid or from DoIPUseMacAddressForIdentification.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_DoIP_00106</RELATED-TRACE-ITEM-REF>
