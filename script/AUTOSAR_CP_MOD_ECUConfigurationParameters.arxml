                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:726d2034-3022-44ab-a46e-67be01d64eac">
                          <SHORT-NAME>EthTrcvPhysLayerPlcaNodeCount</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines the number of communication participants on the mixed segment. This value is relevant for the head-node transceiver (EthTrcvPhysLayerNodeID = 0) in order to know when the BEACON has to be transmitted.</L-2>
                          </DESC>
