                    </ECUC-BOOLEAN-PARAM-DEF>
                    <!-- PARAMETER DEFINITION: PduRTpTransmit -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3ad8528d-f27c-4c20-9826-aa0461824f28">
                      <SHORT-NAME>PduRTpTransmit</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies if BSW module supports the TP Transmit API or not. Value true the API is supported.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_PduR_00361</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
