                        <!-- PARAMETER DEFINITION: TcpIpIpSecSpdCalloutFunction -->
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:ace71e7f-35e6-45c3-b213-f19baaeb606b">
                          <SHORT-NAME>TcpIpIpSecSpdCalloutFunction</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the name of a callout function that shall be called for each Rx/Tx messag, after the IPsec has processed all corresponding SPD entries and has determined the policy. The callout function allows it to override the applied policy.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00290</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
