                        <!-- PARAMETER DEFINITION: IpduMContainedTxPduConfirmation -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ea74c379-a393-4df0-bd9c-2405c7d70434">
                          <SHORT-NAME>IpduMContainedTxPduConfirmation</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This Parameter determines whether for this contained I-PDU a TxConfirmation shall be provided. If set to TRUE a TxConfirmation is issued. It is not used when an I-PDU is requested using the trigger transmit API.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
