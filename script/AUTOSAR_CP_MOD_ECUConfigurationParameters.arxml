                          <SHORT-NAME>FrPOffsetCorrectionOut</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Magnitude of the maximum permissible offset correction value [Microticks]. Remark: Upper limit 15567 for FlexRay Protocol 2.1 Rev A compliance. Remark: Lower limit 15 for FlexRay Protocol 3.0 compliance.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Fr_00421</RELATED-TRACE-ITEM-REF>
