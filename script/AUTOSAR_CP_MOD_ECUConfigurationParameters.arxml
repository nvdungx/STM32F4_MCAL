                        <!-- PARAMETER DEFINITION: IpduMContainerTxSendTimeout -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:9a4008f5-85c6-424a-9d51-5e7833214912">
                          <SHORT-NAME>IpduMContainerTxSendTimeout</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">When this timeout expires the ContainerPdu is triggered for sending. The respective timer is started when the first Pdu is put into the ContainerPdu.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Defined in seconds.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IpduM_00194</RELATED-TRACE-ITEM-REF>
