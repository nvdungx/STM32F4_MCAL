            <LIFE-CYCLE-INFO-SET>
              <SHORT-NAME>AUTOSARParameterDefinition</SHORT-NAME>
              <LIFE-CYCLE-INFOS>
                <!-- LifeCycleInfo: BndMDeviceIndex -->
