                    <!-- PARAMETER DEFINITION: UdpNmPassiveModeEnabled -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:49e42ecf-551d-40e6-a805-1a38037ee5f6">
                      <SHORT-NAME>UdpNmPassiveModeEnabled</SHORT-NAME>
