                            <L-2 L="EN">Indicates whether NIT error status of each cluster shall be detected or not.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrIf_00003</RELATED-TRACE-ITEM-REF>
