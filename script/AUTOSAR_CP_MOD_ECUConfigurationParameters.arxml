                        <!-- PARAMETER DEFINITION: TcpIpIpSecCalloutHeaderFile -->
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:a795bd57-e859-45c1-b499-e8a422370b83">
                          <SHORT-NAME>TcpIpIpSecCalloutHeaderFile</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the name of the header file containing the definition for the functions specified in TcpIpIpSecSpdCalloutFunction and TcpIpIpSecAuditEvent</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00291</RELATED-TRACE-ITEM-REF>
