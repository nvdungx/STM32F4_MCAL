                    <!-- PARAMETER DEFINITION: SecOCOverrideStatusWithDataId -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3da4b287-4eff-4ca0-b736-0b2fc80c485b">
                      <SHORT-NAME>SecOCOverrideStatusWithDataId</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This option defines if the parameter "ValueId" of the function SecOC_VerifyStatusOverride() accepts the freshness value (as a collection of one or more Secured I-PDUs to freshness) or the dataID for individual Secured I-PDUs.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: Function SecOC_VerifyStatusOverride accepts SecOCDataId as parameter. * false: Function SecOC_VerifyStatusOverride accepts SecOCFreshnessValueId as parameter.</L-1>
                        </P>
                      </INTRODUCTION>
