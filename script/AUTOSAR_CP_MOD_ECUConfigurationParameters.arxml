                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: SecOCRxAuthenticLayerPduId -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2083afc5-ca7f-4b80-9de7-eb5cac284b38">
                          <SHORT-NAME>SecOCRxAuthenticLayerPduId</SHORT-NAME>
