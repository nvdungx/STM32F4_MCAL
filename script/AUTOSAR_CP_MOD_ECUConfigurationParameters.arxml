                                  <SHORT-NAME>SecOCTxCryptographicPduId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">PDU identifier of the Cryptographic I-PDU assigned by SecOC module. Used by PduR for confirmation (SecOC_IfTxConfirmation) and for TriggerTransmit.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SecOC_00057</RELATED-TRACE-ITEM-REF>
