                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01125</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <SUB-CONTAINERS>
                                    <!-- Container Definition: DcmSwcDataElementArrayElement -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:63b0f9f6-7ae6-4095-a834-8dfddc5e28b3">
