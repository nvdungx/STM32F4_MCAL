                            <!-- Container Definition: EthTrcvMiiInterface -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4f50a061-e114-4cb1-837b-acbe8a121302">
                              <SHORT-NAME>EthTrcvMiiInterface</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container includes the MII interface configuration between an Ethernet Controller and the Ethernet Transceiver. If this container is configured the EthTrcv shall call Eth_WriteMii / Eth_ReadMii API to access the hardware ethernet tranceiver.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Note: In case of external MACPHY use this parameter may be enabled.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTrcv_00037</RELATED-TRACE-ITEM-REF>
