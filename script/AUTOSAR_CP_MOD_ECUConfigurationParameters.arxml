                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>2047</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: FrRangeMin -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1ea0cf4e-710f-4137-9df4-ce3975680ede">
                                  <SHORT-NAME>FrRangeMin</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">First FrameId of this range that will be accepted by the FIFO.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Fr_00015</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
