                      <SUB-CONTAINERS>
                        <!-- Container Definition: TcpIpTlsCiphersuites -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e252c73c-a1b1-4617-85e6-2f7b0d028513">
                          <SHORT-NAME>TcpIpTlsCiphersuites</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container provides the information about supported ciphersuites used by TLS.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00222</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: TcpIpTlsRootCertUpdateCalloutFunction -->
                            <ECUC-FUNCTION-NAME-DEF UUID="ECUC:52e96b75-6796-4715-b761-b15509d03444">
                              <SHORT-NAME>TcpIpTlsRootCertUpdateCalloutFunction</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This optional parameter specifies the name of a callout function that is used when a new, valid, root certificate is received during a TLS handshake. Can be used to perform actions based on the received certificate.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00330</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
