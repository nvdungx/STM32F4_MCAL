                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: FrIfJobList -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:55b15d51-51ba-463d-897e-aa9fdd385c07">
                          <SHORT-NAME>FrIfJobList</SHORT-NAME>
                          <DESC>
