                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:415d2bf3-43ab-4c40-8589-e6d922795396">
                          <SHORT-NAME>SwCluCBManifOnBoardConnectorControl</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">SwCluCBManifOnBoardConnectorControl enables or disables the onECU execution of the Software Cluster Connector.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This setting is only applicable for the Host Software Cluster.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SwCluC_00011</RELATED-TRACE-ITEM-REF>
