                            <!-- PARAMETER DEFINITION: PduBufferAlignment -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3092130b-8699-4722-a482-035431d1467e">
                              <SHORT-NAME>PduBufferAlignment</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines the byte alignment of temporary local buffers that is required by the hardware. Using this parameter, a configuration can ensure that an upper layer module is aware of the alignment requirements of a driver.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Unit: Byte</L-1>
                                </P>
