                                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7890e369-1416-2683-a170-59dd2d892ce5">
                                              <SHORT-NAME>DcmDspAlternativeDiagnosticDataElement</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation by the means of Diagnostic Extract.</L-2>
                                              </DESC>
                                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01084</RELATED-TRACE-ITEM-REF>
                                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
