                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:27974a6c-244c-4973-a74a-49116aec4c6e">
                          <SHORT-NAME>UdpNmPnHandleMultipleNetworkRequests</SHORT-NAME>
