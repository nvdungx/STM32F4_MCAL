                        <!-- PARAMETER DEFINITION: CanNmAllNmMessagesKeepAwake -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c102fdeb-4831-4ada-9e0b-1c5125f3f909">
                          <SHORT-NAME>CanNmAllNmMessagesKeepAwake</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies if CanNm drops irrelevant NM PDUs.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">false: Only NM PDUs with a PNI bit = true and containing a PN request for this ECU triggers the standard RX indication handling true: Every NM PDU triggers the standard RX indication handling</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00068</RELATED-TRACE-ITEM-REF>
