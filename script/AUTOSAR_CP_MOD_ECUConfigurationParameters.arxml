                      <SUB-CONTAINERS>
                        <!-- Container Definition: XcpDto -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:60a6ecc4-2b81-4fe9-89d8-d37b7abbabc6">
                          <SHORT-NAME>XcpDto</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container collects data transfer object specific parameters for the DAQ list.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Xcp_00065</RELATED-TRACE-ITEM-REF>
