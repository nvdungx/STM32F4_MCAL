                            </ECUC-BOOLEAN-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: EthCtrlConfigSpiSelectTimeStamp -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:291137f5-6695-4e25-92ab-06b555160378">
                              <SHORT-NAME>EthCtrlConfigSpiSelectTimeStamp</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">When timestamp supported by the HW, selects size and format of the timestamps.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">FALSE: 32-bits timestamps TRUE: 64-bit timestamps</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00087</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
