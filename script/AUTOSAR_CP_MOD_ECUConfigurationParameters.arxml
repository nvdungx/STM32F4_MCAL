                                <ECUC-FUNCTION-NAME-DEF UUID="ECUC:a110b234-5b29-4522-8f48-22e283372c56">
                                  <SHORT-NAME>DcmDspStopRoutineConfirmationFnc</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">C-function to call if a transmission confirmation is needed by the issuer (BSW module)</L-2>
                                  </DESC>
