                              <REFERENCES>
                                <!-- Reference Definition: DcmDspDidDataSupportInfoRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:d54f9fbd-eba6-450d-8778-967146e4a9b9">
                                  <SHORT-NAME>DcmDspDidDataSupportInfoRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to DcmDspDidSupportInfo</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01098</RELATED-TRACE-ITEM-REF>
