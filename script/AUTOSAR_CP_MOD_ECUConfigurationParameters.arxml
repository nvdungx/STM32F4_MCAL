                        </ECUC-REFERENCE-DEF>
                        <!-- Symbolic Name Reference Definition: SEV_IDSM_NO_EVENT_BUFFER_AVAILABLE -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:6ec77991-39e9-4354-92aa-3b6aa8ae572b">
                          <SHORT-NAME>SEV_IDSM_NO_EVENT_BUFFER_AVAILABLE</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">A SEv cannot be handled because there are no more event buffers available to process the event.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00074</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
