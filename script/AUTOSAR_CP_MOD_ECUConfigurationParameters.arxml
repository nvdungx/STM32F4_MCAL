                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00075</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
