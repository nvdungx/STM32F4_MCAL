                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:432e0a4c-a916-4082-9bf5-915965ad2861">
                                      <SHORT-NAME>EthSwtStreamGateIPV</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Internal Priority Value (IPV), a priority value that determines the assigned traffic class.</L-2>
                                        <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                      </DESC>
