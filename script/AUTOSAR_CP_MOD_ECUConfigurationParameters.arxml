                                                <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:c034f353-b431-5818-1574-343e35819bd9">
                                                  <SHORT-NAME>DcmDataElement</SHORT-NAME>
                                                  <DESC>
