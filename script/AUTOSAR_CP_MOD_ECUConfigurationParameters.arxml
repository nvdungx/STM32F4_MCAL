                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                  <WITH-AUTO>true</WITH-AUTO>
                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <!-- Reference Definition: FrNmTxUserDataPduRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:97285808-d295-4a50-b81f-188ec22b0b9f">
                                  <SHORT-NAME>FrNmTxUserDataPduRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the NM User Data I-PDU in the global PDU collection.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrNm_00057</RELATED-TRACE-ITEM-REF>
