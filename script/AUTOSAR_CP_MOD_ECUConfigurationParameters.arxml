                                            <!-- PARAMETER DEFINITION: IEEE1722TpStreamAcfTriggerMode -->
                                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:0a086456-e2cf-95ce-675b-f8d9bcf9d149">
                                              <SHORT-NAME>IEEE1722TpStreamAcfTriggerMode</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">Defines whether putting this Can/Lin Pdu to the ACF message</L-2>
                                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                              </DESC>
                                              <INTRODUCTION>
                                                <P>
                                                  <L-1 L="EN">* always or * never triggers immediate sending of the ACF message.</L-1>
                                                </P>
                                              </INTRODUCTION>
                                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IEEE1722Tp_00095</RELATED-TRACE-ITEM-REF>
