                    <!-- Container Definition: FrIfPdu -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6d311fa0-67ff-41db-a650-88f3f78a0738">
                      <SHORT-NAME>FrIfPdu</SHORT-NAME>
