                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: TcpIpTcpConfigOptionFilterId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:295ea4cd-acd8-415a-a227-2fa3ab98c3f1">
                              <SHORT-NAME>TcpIpTcpConfigOptionFilterId</SHORT-NAME>
