                        <L-2 L="EN">Configuration of hardware offloading features.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00030</RELATED-TRACE-ITEM-REF>
