                    <!-- PARAMETER DEFINITION: EthTrcvWakeUpSupport -->
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:2906b28a-56d2-42e4-b090-35c9cc671503">
                      <SHORT-NAME>EthTrcvWakeUpSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configures how to detect a signaled wake-up by hardware: polling, asychronous check via signal, interrupt or to not used/not supported. In case detection of a wake-up is not support (e.g. wake-up detection not needed or Ethernet hardware does not support wake-up detection), the BSWMD pre-configuration shall be set to ETHTRCV_WAKEUP_NOT_SUPPORTED.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthTrcv_00030</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
