                          <SHORT-NAME>ComRxDataTimeoutAction</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the action performed upon expiration of the reception deadline monitoring timer.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00412</RELATED-TRACE-ITEM-REF>
