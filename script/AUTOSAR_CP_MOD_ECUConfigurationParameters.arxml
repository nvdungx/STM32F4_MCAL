                            <L-2 L="EN">Reference to the global Pdu.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SecOC_00025</RELATED-TRACE-ITEM-REF>
