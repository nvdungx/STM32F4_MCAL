                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:082d1202-dae1-4b92-a4f5-c9ad2d74d6ff">
                                      <SHORT-NAME>TcpIpIpV4PathMtuEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the IPv4 processes incoming ICMPv4 "Packet Too Big" messages and stores a MTU value for each destination address.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00211</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: TcpIpIpV4PathMtuTimeout -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:908c40aa-9d8f-4fa0-b90b-48acdd7deebc">
                                      <SHORT-NAME>TcpIpIpV4PathMtuTimeout</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If this value is &gt;0 the IpV4 will reset the MTU value stored for each destination after n seconds.</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">see [RFC1191 6.3. Purging stale PMTU information] Default: 600 seconds (10 minutes)</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00210</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
