                                            <ECUC-REFERENCE-DEF UUID="ECUC:c605a94a-8f46-47f4-a660-d875d0166f23">
                                              <SHORT-NAME>DcmDslPeriodicTxPduRef</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">Reference to a Pdu in EcuC that is used for this periodic transmission channel.</L-2>
                                              </DESC>
                                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_00742</RELATED-TRACE-ITEM-REF>
                                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                              <SCOPE>ECU</SCOPE>
                                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
