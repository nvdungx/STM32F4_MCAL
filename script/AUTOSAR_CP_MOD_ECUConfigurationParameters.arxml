                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>4294967295</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: RamTstFillPattern -->
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9cb6843f-a344-4e37-b442-d28f2b57f222">
                                  <SHORT-NAME>RamTstFillPattern</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Pattern to be filled into each memory cell after destructive test of this block.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_RamTst_00176</RELATED-TRACE-ITEM-REF>
