                    <!-- PARAMETER DEFINITION: DltMaxNumberOfChannels -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5287f725-21be-4d58-83c6-8a6f9744966a">
                      <SHORT-NAME>DltMaxNumberOfChannels</SHORT-NAME>
                      <DESC>
