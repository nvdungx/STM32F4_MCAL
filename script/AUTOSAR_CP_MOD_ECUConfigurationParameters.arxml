                        <!-- Reference Definition: WEthCtrlEcucPartitionRef -->
                        <ECUC-REFERENCE-DEF UUID="ECUC:c031ce2c-8694-4015-9649-e959cb3c42f9">
                          <SHORT-NAME>WEthCtrlEcucPartitionRef</SHORT-NAME>
