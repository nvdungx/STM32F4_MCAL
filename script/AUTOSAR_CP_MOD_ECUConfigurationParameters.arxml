                    <!-- PARAMETER DEFINITION: WEthIndex -->
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1f45f778-fcd4-4778-a78c-7d126e9373d0">
                      <SHORT-NAME>WEthIndex</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0.</L-2>
