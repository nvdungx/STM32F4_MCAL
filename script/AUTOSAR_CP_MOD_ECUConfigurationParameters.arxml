                                    <L-2 L="EN">Referenced Bit of the SupportInfo</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dcm_01097</RELATED-TRACE-ITEM-REF>
