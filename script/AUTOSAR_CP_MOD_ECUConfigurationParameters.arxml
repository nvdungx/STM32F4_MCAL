                                            <!-- Container Definition: IEEE1722TpStreamAcfRxPdu -->
                                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e72b6256-8b54-9c00-5291-6464a379b623">
                                              <SHORT-NAME>IEEE1722TpStreamAcfRxPdu</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">This container defines the EcuC Rx Pdu used for the transport of the network specific payload (Can or Lin).</L-2>
                                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                              </DESC>
                                              <INTRODUCTION>
                                                <P>
                                                  <L-1 L="EN">Dependency: Either IEEE1722TpStreamAcfTxPdu or IEEE1722TpStreamAcfRxPdu shall be provided. Supported MetaData entries for CAN: * IEEE1722TP_COMMON_STREAM_HEADER_PTR * MESSAGE_TIMESTAMP_64 * MESSAGE_TIMESTAMP_VALID_8 * CAN_ID_32 * CAN_ID_PROPS_8 Supported MetaData entries for LIN: * IEEE1722TP_COMMON_STREAM_HEADER_PTR * MESSAGE_TIMESTAMP_64 * MESSAGE_TIMESTAMP_VALID_8 * LIN_NAD_8</L-1>
                                                </P>
                                              </INTRODUCTION>
