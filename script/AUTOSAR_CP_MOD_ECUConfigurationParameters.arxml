                          <SUB-CONTAINERS>
                            <!-- Container Definition: EthTSynCrcTimeFlagsTxSecured -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b5382ff6-ba89-4aa8-8455-6ae63fc1d83d">
                              <SHORT-NAME>EthTSynCrcTimeFlagsTxSecured</SHORT-NAME>
                              <DESC>
