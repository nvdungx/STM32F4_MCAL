                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f2cb7ea0-db7b-8296-6045-de7936d352fe">
