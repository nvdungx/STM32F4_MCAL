                            <!-- PARAMETER DEFINITION: SdClientTimerTTL -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:68fd030c-092e-45b6-9510-b120cdcc8054">
                              <SHORT-NAME>SdClientTimerTTL</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Time to live for find and subscribe messages. Note! The TTL value for find messages shall be ignored by the server service and the configuration is only kept for backward compatibility</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SD_00075</RELATED-TRACE-ITEM-REF>
