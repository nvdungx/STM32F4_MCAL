                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: NmBusSynchronizationEnabled -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b4b6f8dd-8b3f-403f-ad6a-870f65346dcc">
                          <SHORT-NAME>NmBusSynchronizationEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Pre-processor switch for enabling bus synchronization support of the &lt;Bus&gt;Nms. This feature is required for NM Coordinator nodes only.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Nm_00208</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
