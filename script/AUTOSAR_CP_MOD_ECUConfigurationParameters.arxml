                    <!-- PARAMETER DEFINITION: LinIfResponseErrorSignalChangedCallout -->
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:f7a53ed6-d2bc-402b-9202-c378c93f69a6">
                      <SHORT-NAME>LinIfResponseErrorSignalChangedCallout</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter contains the name of the callout function that is called after a response error signal change.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Only applicable for LIN slave nodes.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinIf_00656</RELATED-TRACE-ITEM-REF>
