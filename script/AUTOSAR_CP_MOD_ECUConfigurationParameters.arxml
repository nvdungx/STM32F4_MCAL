                                      <SHORT-NAME>SdEventTriggeringRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Reference to a SoAdRoutingGroup that is used for triggered transmit. Triggering is needed to sent out initial events on the server side after a client got subscribed.</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SD_00095</RELATED-TRACE-ITEM-REF>
