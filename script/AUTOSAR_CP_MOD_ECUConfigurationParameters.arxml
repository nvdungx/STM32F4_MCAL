                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ad16168c-46c7-4522-a792-baedb09c35bf">
                              <SHORT-NAME>IdsMEventThresholdTimeInterval</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Length of the threshold time interval (as float in seconds).</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">Note: Shall be configured as a multiple of the IdsM main function period.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IdsM_00028</RELATED-TRACE-ITEM-REF>
