                    </ECUC-REFERENCE-DEF>
                    <!-- Symbolic Name Reference Definition: XcpNvRamBlockIdRef -->
                    <ECUC-REFERENCE-DEF UUID="ECUC:a0bc88a8-1f03-4434-8e23-0ee65fb131b1">
                      <SHORT-NAME>XcpNvRamBlockIdRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This reference contains the link to a non-volatile memory block to be used in the feature "RESUME MODE" so this information has to be stored non volatile to be available directly after start-up of the ECU.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Xcp_00180</RELATED-TRACE-ITEM-REF>
