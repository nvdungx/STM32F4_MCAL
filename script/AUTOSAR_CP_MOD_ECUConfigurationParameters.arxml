                          <MAX INTERVAL-TYPE="OPEN">INF</MAX>
                          <MIN INTERVAL-TYPE="OPEN">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: DoIPInitialInactivityTime -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:f455792f-afbc-4de1-ab70-30d56a927828">
                          <SHORT-NAME>DoIPInitialInactivityTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout in [s] used for initial inactivity of a connected TCP socket connection directly after socket connection. Represents parameter T_TCP_Initial_Inactivity of ISO 13400-2.</L-2>
                          </DESC>
