                        <!-- PARAMETER DEFINITION: FrSMMinNumberOfColdstarter -->
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:68fdc9b4-34e0-4c84-9828-47f0a4738e51">
                          <SHORT-NAME>FrSMMinNumberOfColdstarter</SHORT-NAME>
                          <DESC>
