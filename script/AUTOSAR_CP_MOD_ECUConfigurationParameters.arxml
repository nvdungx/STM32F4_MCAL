                    <!-- PARAMETER DEFINITION: AdcEnableQueuing -->
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:cf5318b5-011b-4128-8393-02dd46fe52b5">
                      <SHORT-NAME>AdcEnableQueuing</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Determines, if the queuing mechanism is active in case of priority mechanism disabled.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Note: If priority mechanism is enabled, queuing mechanism is always active and the parameter ADC_ENABLE_QUEUING is not evaluated. true: Enabled. false: Disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Adc_00391</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
