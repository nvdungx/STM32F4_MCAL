                                <ECUC-REFERENCE-DEF UUID="ECUC:d92f4f29-dbe9-4834-b3dd-031a34675f81">
                                  <SHORT-NAME>LinIfSubstitutionFrameRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to an unconditional Frame that is used as sporadic frame in a master node or event-triggered frame in a slave node.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_LinIf_00041</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
