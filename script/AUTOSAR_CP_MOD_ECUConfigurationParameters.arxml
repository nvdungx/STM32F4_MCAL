                                <!-- Reference Definition: EthSwtRateVlanMembershipRef -->
                                <ECUC-REFERENCE-DEF UUID="ECUC:b746d413-662f-4337-80a7-c01d9dd5c258">
                                  <SHORT-NAME>EthSwtRateVlanMembershipRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">References the Vlans this rate policy shall apply to.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=obsolete</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">If no EthSwtRateVlanMembershipRef is configured the rate policing applies only on the configured EthSwtPortRatePolicedPriority.</L-1>
                                    </P>
                                    <P>
                                      <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                                    </P>
