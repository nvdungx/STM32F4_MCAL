                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: SwCluCBManifDescriptorTreatment -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c984b30d-2d5c-4fea-9b14-76c2ec789591">
