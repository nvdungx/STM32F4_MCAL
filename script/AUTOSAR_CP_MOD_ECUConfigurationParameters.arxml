                <!-- Container Definition: CV2xGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a539eb5a-2d36-420e-8dac-910359d51210">
                  <SHORT-NAME>CV2xGeneral</SHORT-NAME>
