                        <!-- PARAMETER DEFINITION: SpiTimeClk2Cs -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:756a5087-687e-43ae-8607-2470f7de9db7">
                          <SHORT-NAME>SpiTimeClk2Cs</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timing between clock and chip select assertion (in seconds) - This parameter allows to use a range of values from 10 ns up to 0.01 seconds.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">The real configuration-value used in software BSW-SPI is calculated out of this by the generator-tools.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Spi_00214</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
