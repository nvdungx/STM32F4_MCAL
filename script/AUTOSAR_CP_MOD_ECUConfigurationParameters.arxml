                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: DcmDspStopRoutineConfirmationEnabled -->
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ce8a3808-b24b-4d94-ad6f-b2fa713ef99b">
                                  <SHORT-NAME>DcmDspStopRoutineConfirmationEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Allows to enable/disable the confirmation function to indicate the transmission of a response to a StopRoutine request</L-2>
                                  </DESC>
