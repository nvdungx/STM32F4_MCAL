                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: EthCtrlConfigSpiEnableTxCutThrough -->
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:276f1313-c16b-47c2-9c66-1d817b21d1c8">
                              <SHORT-NAME>EthCtrlConfigSpiEnableTxCutThrough</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">When supported by the HW, enables the cut through mode of frame from SPI host to the network.</L-2>
                                <L-2 L="EN">Tags: atp.Status=draft</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00089</RELATED-TRACE-ITEM-REF>
