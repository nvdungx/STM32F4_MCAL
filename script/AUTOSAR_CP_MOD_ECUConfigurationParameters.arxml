                              <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                              <WITH-AUTO>true</WITH-AUTO>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <!-- Container Definition: TcpIpTlsConfig -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3b52a4d6-4b51-40f7-90ff-369b272d8683">
                      <SHORT-NAME>TcpIpTlsConfig</SHORT-NAME>
