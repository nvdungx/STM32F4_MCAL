                        <P>
                          <L-1 L="EN">* True: API IKE_GetVersionInfo() is available. * False: API IKE_GetVersionInfo() is not available.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_IKE_00008</RELATED-TRACE-ITEM-REF>
