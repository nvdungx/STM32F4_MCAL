                    <!-- Container Definition: SecOCRxSecuredPduLayer -->
                    <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:0d17ebb7-f591-4e4e-b2f0-0ccedce78b25">
                      <SHORT-NAME>SecOCRxSecuredPduLayer</SHORT-NAME>
