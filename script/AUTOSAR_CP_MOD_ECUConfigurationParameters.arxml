                        <!-- PARAMETER DEFINITION: CanTSynGlobalTimeTxIcvSecured -->
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:60bd6d16-4c6e-4f74-a9e2-1d51703a1d24">
                          <SHORT-NAME>CanTSynGlobalTimeTxIcvSecured</SHORT-NAME>
