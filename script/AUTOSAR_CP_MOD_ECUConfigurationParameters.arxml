                        <!-- PARAMETER DEFINITION: SpiBaudrate -->
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:f1768d73-9a2c-4e95-aeda-d9f3b0f3c448">
                          <SHORT-NAME>SpiBaudrate</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter is the communication baudrate - This parameter allows</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">using a range of values, from the point of view of configuration tools, from Hz up to MHz.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Spi_00208</RELATED-TRACE-ITEM-REF>
