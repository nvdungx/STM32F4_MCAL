                            <!-- PARAMETER DEFINITION: SdSubscribeEventgroupRetryMax -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1ffcdb8d-1b08-48fc-84b1-ff02fda90a84">
                              <SHORT-NAME>SdSubscribeEventgroupRetryMax</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Maximum count of retry a subscription, if a subscription to an event group is not acknowledged by SubscribeEventGroupAck or SubscribeEventGroupNack. 0x0=no retry, 0xFF=retry forever (as long as the event group is requested)</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_SD_00132</RELATED-TRACE-ITEM-REF>
