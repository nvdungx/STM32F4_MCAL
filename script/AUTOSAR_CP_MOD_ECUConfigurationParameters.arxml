                            <!-- PARAMETER DEFINITION: FrNmNodeId -->
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1336f412-cc1a-4792-90bc-1b4a097aeb23">
                              <SHORT-NAME>FrNmNodeId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">NM node identifier configured for the respective FlexRay Channel.</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">It is used for identifying the respective NM node in the NM-cluster. It must be unique for each NM node within one NM cluster.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_FrNm_00017</RELATED-TRACE-ITEM-REF>
