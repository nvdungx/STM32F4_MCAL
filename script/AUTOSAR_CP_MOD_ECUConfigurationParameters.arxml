                        <!-- PARAMETER DEFINITION: ComMPncWakeupSleepRequestEnabled -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d8af3162-9bcc-4646-b76e-8f25e93ca32d">
                          <SHORT-NAME>ComMPncWakeupSleepRequestEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Used for PNCs where a requested PNC shall report an active communication request towards the BswM. The BswM forward the active communication request to the lower layer communication channels where the used hardware support wake-up and/or sleep request capability on the network, e.g. OA TC10 compatible PHYs for Ethernet. This is used e.g. for Ethernet Switch port group switching.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_ComM_00899</RELATED-TRACE-ITEM-REF>
